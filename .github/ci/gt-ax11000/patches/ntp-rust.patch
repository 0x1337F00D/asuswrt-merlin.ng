 RUST_SECURITY_MANIFEST := $(RUST_COMPONENTS_DIR)/router-security/Cargo.toml
+RUST_NTP_MANIFEST := $(RUST_COMPONENTS_DIR)/ntp/Cargo.toml
 RUST_TOOLCHAIN ?= 1.85.1
