+ifneq ($(RUST_NTP_BINARY),)
+	@install -D $(RUST_NTP_BINARY) $(INSTALLDIR)/usr/sbin/ntp
+	$(if $(RTCONFIG_DEBUG),,@$(STRIP) $(INSTALLDIR)/usr/sbin/ntp)
+endif
+
 ifeq ($(RTCONFIG_BRCM_HOSTAPD),y)
 	@install $(WPS_PBCD) $(INSTALLDIR)/sbin
 	@$(STRIP) $(INSTALLDIR)/sbin/$(WPS_PBCD)
