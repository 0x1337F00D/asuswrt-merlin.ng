-all: PB rc $(if $(RTCONFIG_BRCM_HOSTAPD), $(WPS_PBCD)) init.prep
+# The memory-safe replacement for the busybox ntpd applet.  rc is the only
+# consumer: start_ntpd() in ntpd.c execs /usr/sbin/ntp and stop_ntpd() matches
+# the process by the name "ntp", so the binary is owned by this package and is
+# installed alongside the /sbin/ntpd_synced symlink that it calls back into.
+# Built only for RTCONFIG_NTPD profiles; the others still use ntpclient and
+# have their own unrelated /sbin/ntp dispatcher symlink.
+ifeq ($(RTCONFIG_NTPD),y)
+ifneq ($(wildcard $(RUST_NTP_MANIFEST)),)
+RUST_NTP_BINARY := $(RUST_TARGET_DIR)/$(RUST_TARGET)/release/ntp
+
+.DEFAULT_GOAL := all
+
+.PHONY: rust-ntp
+
+rust-ntp:
+	CARGO_TARGET_DIR="$(RUST_TARGET_DIR)" \
+	CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABI_LINKER="$(CC)" \
+	RUSTFLAGS="$(RUSTFLAGS) $(RUST_CPU_FLAGS)" \
+		cargo +$(RUST_TOOLCHAIN) build --manifest-path "$(RUST_NTP_MANIFEST)" \
+			-p ntp --bin ntp --release --target "$(RUST_TARGET)" \
+			--locked --offline
+
+$(RUST_NTP_BINARY): rust-ntp
+endif
+endif
+
+all: PB rc $(RUST_NTP_BINARY) $(if $(RTCONFIG_BRCM_HOSTAPD), $(WPS_PBCD)) init.prep
 
 PB:
 	[ ! -d prebuild ] || cp prebuild/*.o ./
@@ -1396,6 +1423,11 @@
 	$(if $(RTCONFIG_DEBUG),,@$(STRIP) $(INSTALLDIR)/sbin/rc)
