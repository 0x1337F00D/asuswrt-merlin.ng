+safe_imported_custom_option(const char *option)
+{
+	static const char *allowed[] = {
+		"auth-nocache", "cipher", "data-ciphers", "data-ciphers-fallback",
+		"dhcp-option", "explicit-exit-notify", "float", "fragment", "inactive",
+		"keepalive", "mssfix", "mute-replay-warnings", "ping", "ping-restart",
