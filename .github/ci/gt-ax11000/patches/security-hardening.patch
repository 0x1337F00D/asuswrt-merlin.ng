+		"route-ipv6", "sndbuf", "tls-version-min", "tun-mtu"
+	};
+	size_t i;
+
+	if (!option)
+		return 0;
+	for (i = 0; i < sizeof(allowed) / sizeof(allowed[0]); ++i) {
+		if (streq(option, allowed[i]))
