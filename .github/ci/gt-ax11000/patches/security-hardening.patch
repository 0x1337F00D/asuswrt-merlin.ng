+	if (pid == 0) {
+		close(pipefd[0]);
+		if (dup2(pipefd[1], STDOUT_FILENO) < 0)
+			_exit(127);
+		close(pipefd[1]);
+		execv(argv[0], argv);
+		_exit(127);
+	}
+	close(pipefd[1]);
+	if (pid < 0) {
+		close(pipefd[0]);
+		return 0;
+	}
+	fp = fdopen(pipefd[0], "r");
+	if (fp) {
+		while (fgets(buf, sizeof(buf), fp) != NULL) {
+			if (expected && strstr(buf, expected))
+				success = 1;
+		}
+		fclose(fp);
+	} else {
+		close(pipefd[0]);
+		success = 0;
+	}
