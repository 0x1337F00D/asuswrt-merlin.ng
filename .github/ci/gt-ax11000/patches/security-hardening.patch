+		strspn(ifname, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.:-") != strlen(ifname))
+		return 0;
+	if (!command || (strcmp(command, "ping") && strcmp(command, "wps_cancel") &&
+		strcmp(command, "set") && strcmp(command, "reload") &&
+		strcmp(command, "update_beacon") && strcmp(command, "disable") &&
+		strcmp(command, "enable")))
+		return 0;
+	if ((!strcmp(command, "set") && (!arg1 || !arg2)) ||
+		(strcmp(command, "set") && (arg1 || arg2)))
+		return 0;
+	if (arg1 && strcmp(arg1, "wps_state"))
+		return 0;
+	if (arg2 && strcmp(arg2, "0") && strcmp(arg2, "2"))
+		return 0;
+
+	argv[argc++] = "/usr/sbin/hostapd_cli";
+	argv[argc++] = "-p";
+	argv[argc++] = HAPD_DIR;
+	argv[argc++] = "-i";
+	argv[argc++] = (char *)ifname;
+	argv[argc++] = (char *)command;
+	if (arg1)
+		argv[argc++] = (char *)arg1;
+	if (arg2)
+		argv[argc++] = (char *)arg2;
+	argv[argc] = NULL;
+
+	if (pipe(pipefd) != 0)
