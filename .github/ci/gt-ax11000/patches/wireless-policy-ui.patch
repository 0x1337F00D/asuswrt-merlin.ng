+function regulatory_lab_prepare_controls(){
+	var selector = document.getElementById("regulatory_lab_country");
+	var currentRegion = (orig_region == "") ? tcode : orig_region;
+	var hasCurrent = false;
+	var hasAll = false;
+	try{
+		if(!selector)
+			throw new Error("missing country selector");
+		for(var i = 0; i < country_array.length; ++i){
+			var index = country_array[i] == "NZ" ? "AU" : country_array[i];
+			if(index == "ALL")
+				hasAll = true;
+			if(index == currentRegion)
+				hasCurrent = true;
+			var country = country_selection_array[index];
+			var option = document.createElement("option");
+			option.value = index;
+			option.textContent = country ? country.name : index;
+			selector.appendChild(option);
+		}
+		if(!hasAll)
+			selector.appendChild(new Option("ALL (Testlabor)", "ALL"));
+		if(!hasCurrent)
+			selector.appendChild(new Option(currentRegion, currentRegion));
+		selector.value = currentRegion;
+	}
+	catch(error){
+		if(selector){
+			selector.disabled = true;
+			selector.title = "Länderauswahl konnte nicht initialisiert werden.";
+		}
+	}
+	regulatory_lab_restore_acknowledgement();
+}
+
+function regulatory_lab_restore_acknowledgement(){
+	var acknowledgement = document.getElementById("regulatory_lab_ack");
+	if(!acknowledgement)
+		return;
+	regulatory_lab_ack_stored = '<% nvram_match("rust_regulatory_testlab_ack_v1", "1", "accepted"); %>' == "accepted";
+	acknowledgement.checked = regulatory_lab_ack_stored;
+	acknowledgement.disabled = regulatory_lab_ack_stored;
+}
+
+function regulatory_lab_render_status(){
+	var target = document.getElementById("regulatory_lab_status");
+	if(!target)
+		return;
+	try{
+		var state = httpApi.nvramGet([
+			"wl0_country_code", "wl0_chanspec", "wl0_acs_dfs", "wl0_txpower",
+			"wl1_country_code", "wl1_chanspec", "wl1_acs_dfs", "wl1_txpower",
+			"wl2_country_code", "wl2_chanspec", "wl2_acs_dfs", "wl2_txpower"
+		]) || {};
+		var channelSets = [
+			httpApi.hookGet("channel_list_2g") || [],
+			httpApi.hookGet("channel_list_5g") || [],
+			httpApi.hookGet("channel_list_5g_2") || []
+		];
+		var labels = ["2.4 GHz", "5 GHz-1", "5 GHz-2"];
+		var lines = [];
+		for(var unit = 0; unit < 3; ++unit){
+			var prefix = "wl" + unit + "_";
+			var channels = Array.isArray(channelSets[unit]) ? channelSets[unit].join(", ") : String(channelSets[unit]);
+			lines.push(labels[unit] + ": Land=" + state[prefix + "country_code"] +
+				", aktueller Kanal=" + state[prefix + "chanspec"] +
+				", DFS=" + (state[prefix + "acs_dfs"] == "1" ? "aktiv" : "inaktiv") +
+				", aktuelle Leistungseinstellung=" + state[prefix + "txpower"] +
+				" % der landes- und boardkalibrierten Obergrenze" +
+				", Treiberkanäle=" + channels);
+		}
+		target.textContent = lines.join("\n");
+	}
+	catch(error){
+		target.textContent = "Der effektive Funkstatus ist vorübergehend nicht verfügbar. Bitte die Seite vor einer Änderung neu laden.";
+	}
+}
+
+var regulatory_lab_ack_stored = false;
+
+function regulatory_lab_store_acknowledgement(){
+	var acknowledgement = document.getElementById("regulatory_lab_ack");
+	if(regulatory_lab_ack_stored || !acknowledgement || !acknowledgement.checked)
+		return true;
+
+	var regionControl = document.getElementById("regulatory_lab_country");
+	var uiRegion = regionControl ? regionControl.value : ((orig_region == "") ? tcode : orig_region);
+	var driverRegion = (U5_country_code && uiRegion == "U5") ? "AA" : uiRegion;
+	var stored = false;
+	$.ajax({
+		url: "/set_regulatory_testlab.cgi",
+		type: "POST",
+		dataType: "json",
+		async: false,
+		data: {
+			"country": driverRegion,
+			"confirmation": "ACKNOWLEDGE_REGULATORY_AND_HARDWARE_RISK_V1",
+			"acknowledge_only": "1"
+		},
+		success: function(response){
+			stored = response && response.statusCode == "0" && response.acknowledged === true;
+		}
+	});
+	if(!stored){
+		alert("Die Bestätigung konnte nicht im NVRAM des Routers gespeichert werden.");
+		return false;
+	}
+	regulatory_lab_ack_stored = true;
+	acknowledgement.checked = true;
+	acknowledgement.disabled = true;
+	return true;
+}
+
+function regulatory_lab_apply_profile(){
+	var regionControl = document.getElementById("regulatory_lab_country");
+	var currentRegion = (orig_region == "") ? tcode : orig_region;
+	if(!regionControl || regionControl.value == currentRegion){
+		var acknowledgement = document.getElementById("regulatory_lab_ack");
+		if(!regulatory_lab_ack_stored &&
+		   (!acknowledgement || !acknowledgement.checked)){
+			alert("Bitte zuerst die Testlabor-Warnung bestätigen.");
+			return false;
+		}
+		if(!regulatory_lab_store_acknowledgement())
+			return false;
+		alert("Die Bestätigung ist dauerhaft im NVRAM gespeichert. Für ein neues Profil bitte ein anderes Land wählen.");
+		return false;
+	}
+	regulatory_lab_change_confirmed();
+	return false;
+}
+
+function regulatory_lab_change_confirmed(){
+	var regionControl = document.getElementById("regulatory_lab_country");
+	var currentRegion = (orig_region == "") ? tcode : orig_region;
+	var regionChanged = regionControl &&
+		(regionControl.value != currentRegion);
+	if(!regionChanged)
+		return true;
+
+	var acknowledgement = document.getElementById("regulatory_lab_ack");
+	if(!acknowledgement || !acknowledgement.checked){
+		alert("Bitte zuerst die Testlabor-Warnung bestätigen.");
+		return false;
+	}
+
+	if(!confirm("Das gewählte Land einschließlich ALL bestimmt Kanäle, DFS-Regeln und die maximale boardkalibrierte Sendeleistung aller Funkmodule. Die korrekte Auswahl liegt in deiner Verantwortung. Fortfahren?"))
+		return false;
+
+	var uiRegion = regionControl.value;
+	var driverRegion = (U5_country_code && uiRegion == "U5") ? "AA" : uiRegion;
+	var applied = false;
+	$.ajax({
+		url: "/set_regulatory_testlab.cgi",
+		type: "POST",
+		dataType: "json",
+		async: false,
+		data: {
+			"country": driverRegion,
+			"confirmation": "ACKNOWLEDGE_REGULATORY_AND_HARDWARE_RISK_V1"
+		},
+		success: function(response){
+			applied = response && response.statusCode == "0" && response.applied === true;
+		}
+	});
+	if(!applied){
+		alert("Das atomare Länderprofil wurde abgelehnt; kein regulatorischer Wert wurde geändert.");
+		return false;
+	}
+	alert("Länderprofil übernommen. WLAN wird neu gestartet; die Seite lädt anschließend neu.");
+	setTimeout(refreshpage, 15000);
+	return false;
+}
