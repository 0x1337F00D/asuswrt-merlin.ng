+/* Shell-free execution boundary.
+ *
+ * Every helper below builds a fixed argv[] and runs it through the vendor
+ * _eval() (shutils.c, execvp with no shell) or through the local
+ * wl_wlif_popen_argv() pipe.  No command string is ever handed to /bin/sh,
+ * so an interface name, SSID, passphrase, WPS PIN or DPP blob can no longer
+ * terminate a command and start another one.
+ *
+ * Every value that reaches an argv element is first checked by the Rust
+ * policy in rust-components/wlif-policy, which is linked into libshared.so.
+ * The predicates return 1 when the value is accepted and 0 otherwise, and
+ * the callers fail closed with the error value they already used.
+ */
+extern int rust_wlif_ifname_ok(const char *value);
+extern int rust_wlif_ctrl_prefix_ok(const char *value);
+extern int rust_wlif_cli_token_ok(const char *value);
+extern int rust_wlif_cli_word_list_ok(const char *value);
