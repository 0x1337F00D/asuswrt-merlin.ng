+/* Runs one wpa_supplicant control command as a fixed argv, with no shell.
+ *
+ * app is the vendor program name (resolved through the vendor's fixed
+ * search directories, with no shell fallback). Every
+ * interpolated value is checked by the Rust policy first; on rejection the
+ * command is not run and -1 is returned, which is the failure value the
+ * callers already treat as "cli cmd failed".
+ */
+static int
+wl_wlif_wpa_cli_run(const char *app, char *ifname, char *nvifname,
+	const char *command, const char *arg)
+{
+	char ctrl_path[WLIF_MIN_BUF] = {0};
+	char *argv[9];
+	int argc = 0;
+
+	if (!app || !ifname || !command || !rust_wlif_cli_token_ok(app) ||
+		!rust_wlif_ifname_ok(ifname) || !rust_wlif_cli_token_ok(command) ||
+		(arg && !rust_wlif_cli_token_ok(arg))) {
+		cprintf("Err: shared %s rejected wpa_cli request\n", __func__);
+		return -1;
+	}
+
+	argv[argc++] = (char *)app;
+#if defined(NEW_WPA_CLI)
+	(void)nvifname;
+	(void)ctrl_path;
+#else
+	if (!nvifname ||
+		!rust_wlif_supplicant_ctrl_path(ctrl_path, sizeof(ctrl_path), nvifname)) {
+		cprintf("Err: shared %s rejected supplicant control path\n", __func__);
+		return -1;
+	}
+	argv[argc++] = "-p";
+	argv[argc++] = ctrl_path;
+#endif
+	argv[argc++] = "-i";
+	argv[argc++] = ifname;
+	argv[argc++] = (char *)command;
+	if (arg) {
+		argv[argc++] = (char *)arg;
+	}
+	argv[argc] = NULL;
+
+	return wl_wlif_run_argv(argv, NULL, 0);
+}
