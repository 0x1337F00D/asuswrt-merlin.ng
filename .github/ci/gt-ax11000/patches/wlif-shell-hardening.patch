diff --git a/release/src/router/shared/wlif_exec.c b/release/src/router/shared/wlif_exec.c
new file mode 100644
index 00000000000..034cbc4987b
--- /dev/null
+++ b/release/src/router/shared/wlif_exec.c
@@ -0,0 +1,198 @@
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "wlif_process.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef WLIF_CLI_DIRS
+#define WLIF_CLI_DIRS "/usr/sbin"
+#endif
+
+/* This process is the sole waiter for its CLI child. Exited children are
+ * observed without reaping, retaining the PID reservation during capture
+ * and group cleanup. The calling router daemon cannot reap this child. */
+enum child_state { CHILD_RUNNING, CHILD_EXITED_UNREAPED, CHILD_LOST };
+
+static int reset_signals(void)
+{
+	struct sigaction action;
+	sigset_t empty;
+	int signal;
+	memset(&action, 0, sizeof(action));
+	action.sa_handler = SIG_DFL;
+	sigemptyset(&action.sa_mask);
+	for (signal = 1; signal < _NSIG; signal++)
+		sigaction(signal, &action, NULL);
+	sigemptyset(&empty);
+	return sigprocmask(SIG_SETMASK, &empty, NULL);
+}
+
+static int close_extra_fds(void)
+{
+	struct dirent64_local {
+		unsigned long long ino;
+		long long offset;
+		unsigned short reclen;
+		unsigned char type;
+		char name[];
+	};
+	union { long long alignment; char bytes[1024]; } entries;
+	int directory = open("/proc/self/fd", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	int count, offset;
+	if (directory < 0) return -1;
+	while ((count = syscall(SYS_getdents64, directory, entries.bytes, sizeof(entries.bytes))) > 0) {
+		for (offset = 0; offset < count;) {
+			struct dirent64_local *entry = (void *)(entries.bytes + offset);
+			unsigned int fd = 0;
+			char *next = entry->name;
+			if (entry->reclen < sizeof(*entry) || entry->reclen > count - offset) {
+				close(directory); errno = EIO; return -1;
+			}
+			while (*next >= '0' && *next <= '9' && fd <= INT_MAX / 10U)
+				fd = fd * 10 + (*next++ - '0');
+			if (!*next && fd > STDERR_FILENO && fd <= INT_MAX && fd != (unsigned)directory)
+				close((int)fd);
+			offset += entry->reclen;
+		}
+	}
+	close(directory);
+	return count < 0 ? -1 : 0;
+}
+
+static void execute_cli(char *const argv[], int capture_fd)
+{
+	const char *directories[] = { WLIF_CLI_DIRS };
+	char path[128];
+	size_t i, app_len = strlen(argv[0]);
+	if (setsid() < 0 || dup2(capture_fd, STDOUT_FILENO) < 0 ||
+	    fcntl(STDOUT_FILENO, F_SETFD, 0) < 0 || close_extra_fds() < 0)
+		_exit(127);
+	for (i = 0; i < sizeof(directories) / sizeof(directories[0]); i++) {
+		size_t length = strlen(directories[i]);
+		if (length + app_len + 2 > sizeof(path)) continue;
+		memcpy(path, directories[i], length);
+		path[length] = '/';
+		memcpy(path + length + 1, argv[0], app_len + 1);
+		execv(path, argv);
+		if (errno != ENOENT && errno != ENOTDIR && errno != EACCES) break;
+	}
+	_exit(127); /* no execvp ENOEXEC shell fallback */
+}
+
+static struct wlif_process_reply supervise(char *const argv[], char *output, size_t capacity)
+{
+	struct wlif_process_reply result = {WLIF_REPLY_MAGIC, 0, 0, 0};
+	enum child_state state = CHILD_RUNNING;
+	long long now = wl_wlif_milliseconds(), deadline;
+	int pipefd[2], fd, flags;
+	pid_t child;
+	if (now < 0) { result.error = errno; return result; }
+	deadline = now + WLIF_CLI_TIMEOUT_MS;
+	if (pipe2(pipefd, O_CLOEXEC) < 0) { result.error = errno; return result; }
+	child = fork();
+	if (child == 0) execute_cli(argv, pipefd[1]);
+	result.error = child < 0 ? errno : 0;
+	close(pipefd[1]);
+	fd = pipefd[0];
+	if (child < 0) { close(fd); return result; }
+	flags = fcntl(fd, F_GETFL);
+	if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) {
+		result.error = errno; goto cleanup;
+	}
+	while (state == CHILD_RUNNING || (capacity && fd >= 0)) {
+		struct pollfd event = {fd, POLLIN, 0};
+		siginfo_t info;
+		char bytes[512];
+		ssize_t count;
+		now = wl_wlif_milliseconds();
+		if (now < 0) { result.error = errno; break; }
+		if (now >= deadline) { result.error = ETIMEDOUT; break; }
+		if (poll(&event, fd >= 0 ? 1 : 0,
+		         deadline - now > 25 ? 25 : (int)(deadline - now)) < 0) {
+			if (errno == EINTR) continue;
+			result.error = errno; break;
+		}
+		if (fd >= 0 && (event.revents & (POLLIN | POLLHUP | POLLERR))) {
+			count = read(fd, bytes, sizeof(bytes));
+			if (count > 0 && capacity) {
+				if ((size_t)count >= capacity - result.length) { result.error = EOVERFLOW; break; }
+				memcpy(output + result.length, bytes, (size_t)count);
+				result.length += (uint32_t)count;
+			} else if (!count) {
+				close(fd); fd = -1;
+			} else if (count < 0 && errno != EAGAIN && errno != EINTR) {
+				result.error = errno; break;
+			}
+		}
+		if (state == CHILD_RUNNING) {
+			memset(&info, 0, sizeof(info));
+			if (waitid(P_PID, (id_t)child, &info, WEXITED | WNOHANG | WNOWAIT) < 0) {
+				if (errno == EINTR) continue;
+				/* Impossible with our default SIGCHLD and sole waiter,
+				 * but never signal if the ownership invariant is lost. */
+				result.error = errno; state = CHILD_LOST; break;
+			}
+			if (info.si_pid == child) state = CHILD_EXITED_UNREAPED;
+		}
+	}
+cleanup:
+	if (fd >= 0) close(fd);
+	if (state != CHILD_LOST) {
+		if (result.error) {
+			/* PID is still reserved: nobody has called a reaping wait.
+			 * Group kill handles pipe-holding descendants in that group. */
+			kill(-child, SIGKILL);
+			if (state == CHILD_RUNNING) kill(child, SIGKILL);
+		}
+		while (waitpid(child, &result.status, 0) < 0) {
+			if (errno == EINTR) continue;
+			if (!result.error) result.error = errno;
+			break;
+		}
+	}
+	if (result.error) result.length = 0;
+	return result;
+}
+
+static int write_all(int fd, const void *buffer, size_t length)
+{
+	const char *next = buffer;
+	while (length) {
+		ssize_t count = write(fd, next, length);
+		if (count < 0 && errno == EINTR) continue;
+		if (count <= 0) return -1;
+		next += count; length -= (size_t)count;
+	}
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	struct wlif_process_reply result = {WLIF_REPLY_MAGIC, 0, EINVAL, 0};
+	char capture[WLIF_CAPTURE_MAX], *end;
+	unsigned long capacity;
+	if (reset_signals() < 0 || close_extra_fds() < 0) {
+		result.error = errno; goto report;
+	}
+	if (argc < 3 || argc > WLIF_ARG_MAX + 2) goto report;
+	errno = 0;
+	capacity = strtoul(argv[1], &end, 10);
+	if (errno || !argv[1][0] || *end || capacity > sizeof(capture)) goto report;
+	/* These are the only vendor tools used by the validated C call sites. */
+	if (strcmp(argv[2], "hostapd_cli") && strcmp(argv[2], "hostapd_cli-2.7") &&
+	    strcmp(argv[2], "wpa_cli") && strcmp(argv[2], "wpa_cli-2.7")) goto report;
+	result = supervise(argv + 2, capture, capacity);
+report:
+	if (write_all(STDOUT_FILENO, &result, sizeof(result)) == 0 && result.length)
+		write_all(STDOUT_FILENO, capture, result.length);
+	_exit(0);
+}
diff --git a/release/src/router/shared/wlif_process.c b/release/src/router/shared/wlif_process.c
new file mode 100644
index 00000000000..0f2a6f8caad
--- /dev/null
+++ b/release/src/router/shared/wlif_process.c
@@ -0,0 +1,142 @@
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "wlif_process.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern char **environ;
+
+/* glibc's posix_spawn does not invoke caller pthread_atfork callbacks.
+ * The helper also gets its own process group, so caller-group shutdown
+ * cannot remove the CLI's sole supervisor. No shell or PATH search. */
+static int start_helper(char *const args[], int pipefd[2], pid_t *helper)
+{
+	posix_spawn_file_actions_t actions;
+	posix_spawnattr_t attributes;
+	sigset_t defaults, empty;
+	int error = posix_spawn_file_actions_init(&actions);
+	if (error) return error;
+	error = posix_spawnattr_init(&attributes);
+	if (error) { posix_spawn_file_actions_destroy(&actions); return error; }
+	sigfillset(&defaults);
+	sigemptyset(&empty);
+	if (!(error = posix_spawn_file_actions_addclose(&actions, pipefd[0])) &&
+	    !(error = posix_spawn_file_actions_adddup2(&actions, pipefd[1], STDOUT_FILENO)) &&
+	    !(error = posix_spawn_file_actions_addopen(&actions, STDIN_FILENO, "/dev/null", O_RDWR, 0)) &&
+	    !(error = posix_spawn_file_actions_adddup2(&actions, STDIN_FILENO, STDERR_FILENO)) &&
+	    !(error = posix_spawnattr_setpgroup(&attributes, 0)) &&
+	    !(error = posix_spawnattr_setsigdefault(&attributes, &defaults)) &&
+	    !(error = posix_spawnattr_setsigmask(&attributes, &empty)) &&
+	    !(error = posix_spawnattr_setflags(&attributes,
+	        POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK)))
+		error = posix_spawn(helper, WLIF_HELPER_PATH, &actions, &attributes, args, environ);
+	posix_spawnattr_destroy(&attributes);
+	posix_spawn_file_actions_destroy(&actions);
+	return error;
+}
+
+/* Reads are bounded independently of the helper. A malformed or crashed
+ * helper cannot publish partial output as a successful command response. */
+static int receive_exact(int fd, void *buffer, size_t length, long long deadline)
+{
+	char *next = buffer;
+	while (length) {
+		struct pollfd event = {fd, POLLIN, 0};
+		long long now = wl_wlif_milliseconds();
+		ssize_t count;
+		if (now < 0)
+			return -1;
+		if (now >= deadline) { errno = ETIMEDOUT; return -1; }
+		if (poll(&event, 1, (int)(deadline - now)) < 0) {
+			if (errno == EINTR) continue;
+			return -1;
+		}
+		if (!(event.revents & (POLLIN | POLLHUP | POLLERR | POLLNVAL))) continue;
+		count = read(fd, next, length);
+		if (count < 0) {
+			if (errno == EINTR || errno == EAGAIN) continue;
+			return -1;
+		}
+		if (!count) { errno = EIO; return -1; }
+		next += count;
+		length -= (size_t)count;
+	}
+	return 0;
+}
+
+int wl_wlif_run_argv(char *const argv[], char *output, size_t output_size)
+{
+	char *helper_args[WLIF_ARG_MAX + 3];
+	char limit[16];
+	struct wlif_process_reply reply;
+	long long now, deadline;
+	int pipefd[2], error = 0, status, flags, complete = 0;
+	size_t argc;
+	pid_t helper;
+	if (output && output_size) output[0] = '\0';
+	if (!argv || !argv[0] || strchr(argv[0], '/') ||
+	    (output && (!output_size || output_size > WLIF_CAPTURE_MAX))) {
+		errno = EINVAL; return -1;
+	}
+	for (argc = 0; argc < WLIF_ARG_MAX && argv[argc]; argc++)
+		helper_args[argc + 2] = argv[argc];
+	if (argc == WLIF_ARG_MAX) { errno = E2BIG; return -1; }
+	helper_args[argc + 2] = NULL;
+	snprintf(limit, sizeof(limit), "%u", output ? (unsigned)output_size : 0);
+	helper_args[0] = (char *)WLIF_HELPER_PATH;
+	helper_args[1] = limit;
+	now = wl_wlif_milliseconds();
+	if (now < 0) return -1;
+	deadline = now + WLIF_CLI_TIMEOUT_MS + 1000;
+	if (pipe2(pipefd, O_CLOEXEC) < 0) return -1;
+	/* Target glibc 2.26 leaves CLOEXEC set for spawn dup2(fd, fd).
+	 * Always give its stdout action a distinct source descriptor. */
+	if (pipefd[1] <= STDERR_FILENO) {
+		int duplicate = fcntl(pipefd[1], F_DUPFD_CLOEXEC, STDERR_FILENO + 1);
+		if (duplicate < 0) {
+			error = errno; close(pipefd[0]); close(pipefd[1]);
+			errno = error; return -1;
+		}
+		close(pipefd[1]); pipefd[1] = duplicate;
+	}
+	error = start_helper(helper_args, pipefd, &helper);
+	close(pipefd[1]);
+	if (error) { close(pipefd[0]); errno = error; return -1; }
+	flags = fcntl(pipefd[0], F_GETFL);
+	if (flags < 0 || fcntl(pipefd[0], F_SETFL, flags | O_NONBLOCK) < 0 ||
+	    receive_exact(pipefd[0], &reply, sizeof(reply), deadline) < 0) {
+		error = errno;
+	} else if (reply.magic != WLIF_REPLY_MAGIC || reply.error < 0 ||
+	           (!reply.error && reply.status < 0) ||
+	           (reply.length && (!output || reply.length >= output_size))) {
+		error = EPROTO;
+	} else if (reply.error) {
+		complete = 1;
+		error = reply.error;
+	} else if (reply.length &&
+	           receive_exact(pipefd[0], output, reply.length, deadline) < 0) {
+		error = errno;
+	} else {
+		complete = 1;
+		if (output) output[reply.length] = '\0';
+	}
+	close(pipefd[0]);
+	/* Never kill a helper by numeric PID. Other threads or SIG_IGN may
+	 * already have reaped it. On a complete reply it only has _exit left;
+	 * on transport failure, do not block beyond the parent's deadline. */
+	while (waitpid(helper, &status, complete ? 0 : WNOHANG) < 0 && errno == EINTR)
+		;
+	if (error) {
+		if (output && output_size) output[0] = '\0';
+		errno = error; return -1;
+	}
+	return reply.status;
+}
diff --git a/release/src/router/shared/wlif_process.h b/release/src/router/shared/wlif_process.h
new file mode 100644
index 00000000000..a6fd0fe8d96
--- /dev/null
+++ b/release/src/router/shared/wlif_process.h
@@ -0,0 +1,38 @@
+#ifndef WLIF_PROCESS_H
+#define WLIF_PROCESS_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <time.h>
+
+#ifndef WLIF_CLI_TIMEOUT_MS
+#define WLIF_CLI_TIMEOUT_MS 30000
+#endif
+#ifndef WLIF_HELPER_PATH
+#define WLIF_HELPER_PATH "/usr/sbin/wlif-exec"
+#endif
+#define WLIF_CAPTURE_MAX 4096
+#define WLIF_ARG_MAX 32
+#define WLIF_REPLY_MAGIC UINT32_C(0x574c5031)
+
+/* Local same-ABI pipe protocol, never a network format. CLI stdout cannot
+ * access this pipe; only the supervisor writes the final complete result. */
+struct wlif_process_reply {
+	uint32_t magic;
+	int32_t status;
+	int32_t error;
+	uint32_t length;
+};
+
+static inline long long wl_wlif_milliseconds(void)
+{
+	struct timespec now;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+		return -1;
+	return (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+/* Fixed argv, raw wait status; -1/errno for transport/supervision failure.
+ * Domain validation stays in wlif-policy. No caller-side PID signaling. */
+int wl_wlif_run_argv(char *const argv[], char *output, size_t output_size);
+#endif
