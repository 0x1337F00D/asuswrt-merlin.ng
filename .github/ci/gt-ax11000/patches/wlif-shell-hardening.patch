+
+/* Close actual descriptors, not a possibly million-entry RLIMIT range.
+ * Use getdents64 directly: no allocator or stdio locks after fork(). */
+static int
+wl_wlif_close_fds(void)
+{
+	struct wlif_dirent64 {
+		unsigned long long ino;
+		long long offset;
+		unsigned short reclen;
+		unsigned char type;
+		char name[];
+	};
+	union { long long alignment; char bytes[1024]; } entries;
+	int directory, count, offset;
+	directory = open("/proc/self/fd", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (directory < 0)
+		return -1;
+	while ((count = syscall(SYS_getdents64, directory, entries.bytes, sizeof(entries.bytes))) > 0) {
+		for (offset = 0; offset < count;) {
+			struct wlif_dirent64 *entry = (void *)(entries.bytes + offset);
+			unsigned int fd = 0;
+			char *p = entry->name;
+			if (entry->reclen < sizeof(*entry) || entry->reclen > count - offset) {
+				close(directory);
+				return -1;
+			}
+			while (*p >= '0' && *p <= '9' && fd <= INT_MAX / 10U)
+				fd = fd * 10 + (*p++ - '0');
+			if (!*p && fd > STDERR_FILENO && fd <= INT_MAX && fd != (unsigned int)directory)
+				close((int)fd);
+			offset += entry->reclen;
+		}
+	}
+	close(directory);
+	return count < 0 ? -1 : 0;
+}
+
+static long long
+wl_wlif_milliseconds(void)
+{
+	struct timespec now;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+		return -1;
+	return (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+/* Raw system()-style wait status, -1/errno on supervisor failure.
+ * Capture is bounded and complete before parsing; overflow/timeout clears
+ * it. A private runner also avoids debug_logeval exposing credentials.
+ * Search the vendor's fixed PATH without execvp's ENOEXEC shell fallback.
+ */
+static int
+wl_wlif_run_argv(char *const argv[], char *output, size_t output_size)
+{
+	int pipefd[2], status = 0, error = 0, done = 0, fd, flags;
+	pid_t child, waited;
+	long long deadline, now;
+	size_t used = 0;
+	sigset_t blocked, saved;
+	if (output && output_size)
+		output[0] = '\0';
+	if (!argv || !argv[0] || strchr(argv[0], '/') || (output && !output_size)) {
+		errno = EINVAL;
+		return -1;
+	}
+	if ((now = wl_wlif_milliseconds()) < 0)
+		return -1;
+	deadline = now + WLIF_CLI_TIMEOUT_MS;
+	if (pipe2(pipefd, O_CLOEXEC) < 0)
+		return -1;
+	sigemptyset(&blocked);
+	sigaddset(&blocked, SIGCHLD);
+	if (sigprocmask(SIG_BLOCK, &blocked, &saved) < 0) {
+		error = errno;
+		close(pipefd[0]);
+		close(pipefd[1]);
+		errno = error;
+		return -1;
+	}
+	child = fork();
+	if (child == 0) {
+		const char *directories[] = { WLIF_CLI_DIRS };
+		char path[128];
+		size_t i;
+		struct sigaction action;
+		if (setsid() < 0 || dup2(pipefd[1], STDOUT_FILENO) < 0)
+			_exit(127);
+		/* dup2 is a no-op when the pipe already is stdout. */
+		if (fcntl(STDOUT_FILENO, F_SETFD, 0) < 0)
+			_exit(127);
+		fd = open("/dev/null", O_RDWR);
+		if (fd < 0 || dup2(fd, STDIN_FILENO) < 0 || dup2(fd, STDERR_FILENO) < 0)
+			_exit(127);
+		if (wl_wlif_close_fds() < 0)
+			_exit(127);
+		memset(&action, 0, sizeof(action));
+		action.sa_handler = SIG_DFL;
+		sigemptyset(&action.sa_mask);
+		for (fd = 1; fd < _NSIG; fd++)
+			sigaction(fd, &action, NULL);
+		sigemptyset(&blocked);
+		sigprocmask(SIG_SETMASK, &blocked, NULL);
+		for (i = 0; i < sizeof(directories) / sizeof(directories[0]); i++) {
+			size_t dir_len = strlen(directories[i]), app_len = strlen(argv[0]);
+			if (dir_len + app_len + 2 > sizeof(path))
+				continue;
+			memcpy(path, directories[i], dir_len);
+			path[dir_len] = '/';
+			memcpy(path + dir_len + 1, argv[0], app_len + 1);
+			execv(path, argv);
+			if (errno != ENOENT && errno != ENOTDIR && errno != EACCES)
+				break;
+		}
+		_exit(127);
+	}
+	error = child < 0 ? errno : 0;
+	close(pipefd[1]);
+	fd = pipefd[0];
+	if (child < 0)
+		goto finish;
+	flags = fcntl(fd, F_GETFL);
+	if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) {
+		error = errno;
+		goto stop;
+	}
+	while (!done || fd >= 0) {
+		struct pollfd pollfd = { fd, POLLIN, 0 };
+		char buffer[512];
+		ssize_t count;
+		if ((now = wl_wlif_milliseconds()) < 0) {
+			error = errno;
+			goto stop;
+		}
+		if (now >= deadline) {
+			error = ETIMEDOUT;
+			goto stop;
+		}
+		if (poll(&pollfd, fd >= 0 ? 1 : 0, deadline - now > 50 ? 50 : deadline - now) < 0 && errno != EINTR) {
+			error = errno;
+			goto stop;
+		}
+		if (fd >= 0 && (pollfd.revents & (POLLIN | POLLHUP | POLLERR))) {
+			count = read(fd, buffer, sizeof(buffer));
+			if (count > 0 && output) {
+				if ((size_t)count >= output_size - used) {
+					error = EOVERFLOW;
+					goto stop;
+				}
+				memcpy(output + used, buffer, count);
+				used += count;
+				output[used] = '\0';
+			} else if (count == 0) {
+				close(fd);
+				fd = -1;
+			} else if (count < 0 && errno != EAGAIN && errno != EINTR) {
+				error = errno;
+				goto stop;
+			}
+		}
+		if (!done) {
+			waited = waitpid(child, &status, WNOHANG);
+			if (waited == child)
+				done = 1;
+			else if (waited < 0 && errno != EINTR) {
+				error = errno;
+				goto stop;
+			}
+		}
+	}
+	goto finish;
+stop:
+	/* Kill the process group too: descendants can hold stdout open. */
+	kill(-child, SIGKILL);
+	if (!done) {
+		kill(child, SIGKILL);
+		while (waitpid(child, &status, 0) < 0 && errno == EINTR)
+			;
+	}
+finish:
+	if (fd >= 0)
+		close(fd);
+	sigprocmask(SIG_SETMASK, &saved, NULL);
+	if (error) {
+		if (output && output_size)
+			output[0] = '\0';
+		errno = error;
+		return -1;
+	}
+	return status;
+}
