+/* Runs "wpa_cli -i <ifname> <command> [arg]" as a fixed argv, with no shell.
+ * Returns raw wait status, or -1 when the policy or supervisor rejects it.
+ */
+static int
+wl_wlif_supplicant_cmd(char *ifname, const char *command, const char *arg)
+{
+	char *argv[6];
+	int argc = 0;
+
+	if (!ifname || !command || !rust_wlif_ifname_ok(ifname) ||
+		!rust_wlif_cli_token_ok(command) || (arg && !rust_wlif_cli_token_ok(arg))) {
+		cprintf("Err: %s rejected wpa_cli request\n", __func__);
+		return -1;
+	}
+
+	argv[argc++] = "wpa_cli";
+	argv[argc++] = "-i";
+	argv[argc++] = ifname;
+	argv[argc++] = (char *)command;
+	if (arg) {
+		argv[argc++] = (char *)arg;
+	}
+	argv[argc] = NULL;
+
+	dprintf("Info: shared %d: wpa_cli %s\n", __LINE__, command);
+
+	return wl_wlif_run_argv(argv, NULL, 0);
+}
+
+/* Runs "wpa_cli -i <ifname> set_network <id> <key> <value>" as a fixed argv.
+ * value travels as exactly one argument, which is what the previous shell
+ * form produced after quote removal, and is never logged: an SSID, PSK,
+ * SAE password or DPP blob must reach neither /bin/sh nor the console.
+ * The caller has already checked it with the matching Rust predicate.
+ */
+static int
+wl_wlif_supplicant_set_network(char *ifname, const char *network_id,
+	const char *key, const char *value)
+{
+	char *argv[8];
+
+	if (!ifname || !network_id || !key || !value || !rust_wlif_ifname_ok(ifname) ||
+		!rust_wlif_cli_token_ok(network_id) || !rust_wlif_cli_token_ok(key)) {
+		cprintf("Err: %s rejected set_network request\n", __func__);
+		return -1;
+	}
+
+	argv[0] = "wpa_cli";
+	argv[1] = "-i";
+	argv[2] = ifname;
+	argv[3] = "set_network";
+	argv[4] = (char *)network_id;
+	argv[5] = (char *)key;
+	argv[6] = (char *)value;
+	argv[7] = NULL;
+
+	dprintf("Info: shared %d: set_network %s\n", __LINE__, key);
+
+	return wl_wlif_run_argv(argv, NULL, 0);
+}
+
+/* Applies one NVRAM DPP blob, which the supplicant takes unquoted. */
+static int
+wl_wlif_supplicant_set_dpp(char *ifname, const char *network_id, const char *key,
+	const char *value)
+{
+	if (!rust_wlif_dpp_value_ok(value)) {
+		cprintf("Err: %s rejected dpp value for %s\n", __func__, key);
+		return -1;
+	}
+
+	return wl_wlif_supplicant_set_network(ifname, network_id, key, value);
+}
