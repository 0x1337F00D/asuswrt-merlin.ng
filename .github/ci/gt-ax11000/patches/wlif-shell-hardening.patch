+# wlif_utils_ax.c no longer builds shell command strings; every value it
+# passes to hostapd_cli/wpa_cli is validated by this archive first.  The
+# validator keeps its own small UTF-8 implementation; do not replace it
+# with a standard-library call without measuring the complete vendor link.
+# libshared.a keeps the plain object list: nothing in this profile links it.
+RUST_COMPONENTS_DIR ?= $(TOP)/rust-components
+RUST_WLIF_MANIFEST := $(RUST_COMPONENTS_DIR)/wlif-policy/Cargo.toml
+RUST_TOOLCHAIN ?= 1.85.1
+RUST_TARGET ?= armv7-unknown-linux-gnueabi
+RUST_TARGET_DIR ?= $(RUST_COMPONENTS_DIR)/target
+RUST_CPU_FLAGS ?= -Ctarget-cpu=cortex-a9
+
+ifneq ($(wildcard $(RUST_WLIF_MANIFEST)),)
+RUST_WLIF_LIB := $(RUST_TARGET_DIR)/$(RUST_TARGET)/release/libwlif_policy.a
+# The archive carries the Rust runtime.  On its own it needs only libc and
+# libgcc_s, but in this link the vendor objects' undefined memcpy/memset can
+# be satisfied from the archive's compiler_builtins, which drags in members
+# that reference dlsym.  Name the system libraries explicitly, the same set
+# httpd and rc already use for their Rust archives, so libshared.so records
+# them instead of leaving a symbol for every consumer to resolve.
+RUST_WLIF_SYSTEM_LIBS := -ldl -lpthread -lrt
+
+.DEFAULT_GOAL := all
+
+.PHONY: rust-wlif-policy
+
+rust-wlif-policy:
+	CARGO_TARGET_DIR="$(RUST_TARGET_DIR)" \
+	CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABI_LINKER="$(CC)" \
+	RUSTFLAGS="$(RUSTFLAGS) $(RUST_CPU_FLAGS)" \
+		cargo +$(RUST_TOOLCHAIN) build --manifest-path "$(RUST_WLIF_MANIFEST)" \
+			-p wlif-policy --release --target "$(RUST_TARGET)" --locked --offline
+
+$(RUST_WLIF_LIB): rust-wlif-policy
+endif
+
 all: libshared.so libshared.a
 
 
-libshared.so: $(OBJS)
+libshared.so: $(OBJS) $(RUST_WLIF_LIB)
 	@echo " [shared] LD $@"
 ifeq ($(HND_ROUTER),y)
-	@$(CC) $(LDFLAGS) $(EXTRA_LD_FLAGS) -shared -o $@ $^
+	@$(CC) $(LDFLAGS) $(EXTRA_LD_FLAGS) -shared -o $@ $^ $(RUST_WLIF_SYSTEM_LIBS)
 else
-	@$(LD) $(LDFLAGS) -shared -o $@ $^
+	@$(LD) $(LDFLAGS) -shared -o $@ $^ $(RUST_WLIF_SYSTEM_LIBS)
 endif
 
 	$(SIZECHECK)
