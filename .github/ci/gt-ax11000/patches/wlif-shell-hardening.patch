+extern int rust_wlif_supplicant_ctrl_dir(char *out, size_t out_len, const char *prefix);
+
+#if defined(CONFIG_HOSTAPD) || \
+	(defined(RTCONFIG_WIFI7) && defined(RTCONFIG_MLO) && defined(RTCONFIG_BRCM_HOSTAPD))
+#define WLIF_ARGV_EXEC
+
+/* Runs argv[] with stdout connected to a pipe and no shell in between.
+ * Returns the read end of the pipe and stores the child pid, or -1.
+ * This is the fixed-argv replacement for the vendor's shell-parsed stdout
+ * capture: shutils.c safe_popen() still takes a command string and re-splits
+ * it, which is exactly the boundary being removed here.
+ */
+static int
+wl_wlif_popen_argv(char *const argv[], pid_t *child_pid)
+{
+	int pipefd[2];
+	pid_t pid;
+
+	if (!argv || !argv[0] || !child_pid) {
+		return -1;
+	}
+
+	if (pipe(pipefd) < 0) {
+		return -1;
+	}
+
+	pid = fork();
+	if (pid < 0) {
+		close(pipefd[0]);
+		close(pipefd[1]);
+		return -1;
+	}
+
+	if (pid == 0) {
+		int null_fd;
+
+		close(pipefd[0]);
+		if (pipefd[1] != STDOUT_FILENO) {
+			dup2(pipefd[1], STDOUT_FILENO);
+			close(pipefd[1]);
+		}
+		null_fd = open("/dev/null", O_RDWR);
+		if (null_fd >= 0) {
+			dup2(null_fd, STDIN_FILENO);
+			dup2(null_fd, STDERR_FILENO);
+			if (null_fd > STDERR_FILENO) {
+				close(null_fd);
+			}
+		}
+		execvp(argv[0], argv);
+		_exit(127);
+	}
+
+	close(pipefd[1]);
+	*child_pid = pid;
+
+	return pipefd[0];
+}
+
+/* Closes the read end (when fd is not -1) and reaps the child. */
+static void
+wl_wlif_pclose_argv(int fd, pid_t child_pid)
+{
+	int status;
+
+	if (fd >= 0) {
+		close(fd);
+	}
+
+	while (child_pid > 0 && waitpid(child_pid, &status, 0) < 0) {
+		if (errno != EINTR) {
+			break;
+		}
+	}
+}
