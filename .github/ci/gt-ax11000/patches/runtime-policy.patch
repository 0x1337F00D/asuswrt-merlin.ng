+static const char *wlan_candidate_value(json_object *root, const char *generic,
+	const char *specific)
+{
+	char *candidate = get_cgi_json(generic, root);
+	return candidate ? candidate : nvram_safe_get(specific);
+}
+
+static int validate_wlan_security_tuple(json_object *root, int unit,
+	const char *wps_override)
+{
+	char prefix[16], key[32];
+	const char *authentication, *cipher, *pmf, *wps;
+
+	if (unit < 0 || unit > 2)
+		return 0;
+	snprintf(prefix, sizeof(prefix), "wl%d_", unit);
+	strlcat_r(prefix, "auth_mode_x", key, sizeof(key));
+	authentication = wlan_candidate_value(root, "wl_auth_mode_x", key);
+	strlcat_r(prefix, "crypto", key, sizeof(key));
+	cipher = wlan_candidate_value(root, "wl_crypto", key);
+	strlcat_r(prefix, "mfp", key, sizeof(key));
+	pmf = wlan_candidate_value(root, "wl_mfp", key);
+	wps = wps_override ? wps_override :
+		wlan_candidate_value(root, "wps_enable", "wps_enable");
+
+	return rust_httpd_wlan_security_validate(authentication, strlen(authentication),
+		cipher, strlen(cipher), pmf, strlen(pmf), wps, strlen(wps),
+		nvram_match("rust_wlan_allow_transition", "1"),
+		nvram_match("rust_wlan_allow_wps_wpa2", "1"));
+}
+
+static int validate_wlan_security_request(json_object *root)
+{
+	char *unit_value;
+	char *wps_value;
+	int unit;
+
+	if (!get_cgi_json("wl_auth_mode_x", root) &&
+	    !get_cgi_json("wl_crypto", root) &&
+	    !get_cgi_json("wl_mfp", root) &&
+	    !get_cgi_json("wps_enable", root))
+		return 1;
+	wps_value = get_cgi_json("wps_enable", root);
+	if (wps_value && !strcmp(wps_value, "0") &&
+	    !get_cgi_json("wl_auth_mode_x", root) &&
+	    !get_cgi_json("wl_crypto", root) &&
+	    !get_cgi_json("wl_mfp", root))
+		return 1;
+	unit_value = get_cgi_json("wl_unit", root);
+	unit = unit_value ? safe_atoi(unit_value) : nvram_get_int("wl_unit");
+	return validate_wlan_security_tuple(root, unit, NULL);
+}
