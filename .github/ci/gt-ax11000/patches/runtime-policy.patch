+extern int rust_validate_effective_firewall_files(const char *ipv4_path,
+	const char *ipv6_path, int require_ipv6);
+
+static int validate_effective_firewall_policy(void)
+{
+	static const char ipv4_path[] = "/tmp/firewall-effective-v4.rules";
+#ifdef RTCONFIG_IPV6
+	static const char ipv6_path[] = "/tmp/firewall-effective-v6.rules";
+#endif
+	char *ipv4_argv[] = { "iptables-save", "-t", "filter", NULL };
+#ifdef RTCONFIG_IPV6
+	char *ipv6_argv[] = { "ip6tables-save", "-t", "filter", NULL };
+	int require_ipv6 = ipv6_enabled();
+#else
+	int require_ipv6 = 0;
+#endif
+	int valid = 0;
+
+	unlink(ipv4_path);
+#ifdef RTCONFIG_IPV6
+	unlink(ipv6_path);
+#endif
+	if (_eval(ipv4_argv, ">/tmp/firewall-effective-v4.rules", 0, NULL) != 0 ||
+	    chmod(ipv4_path, 0600) != 0)
+		goto out;
+#ifdef RTCONFIG_IPV6
+	if (require_ipv6 &&
+	    (_eval(ipv6_argv, ">/tmp/firewall-effective-v6.rules", 0, NULL) != 0 ||
+	     chmod(ipv6_path, 0600) != 0))
+		goto out;
+	valid = rust_validate_effective_firewall_files(ipv4_path,
+		require_ipv6 ? ipv6_path : NULL, require_ipv6);
+#else
+	valid = rust_validate_effective_firewall_files(ipv4_path, NULL, 0);
+#endif
+
+out:
+	unlink(ipv4_path);
+#ifdef RTCONFIG_IPV6
+	unlink(ipv6_path);
+#endif
+	return valid;
+}
+
+static void firewall_enter_fail_closed(void)
+{
+	int emergency_v4 = 0;
+#ifdef RTCONFIG_IPV6
+	int emergency_v6 = 0;
+#endif
+
+	f_write_string("/proc/sys/net/ipv4/ip_forward", "0", 0, 0);
+#ifdef RTCONFIG_IPV6
+	f_write_string("/proc/sys/net/ipv6/conf/all/forwarding", "0", 0, 0);
+#endif
+	if (firewall_fail_wan_if[0]) {
+		emergency_v4 = eval("iptables", "-I", "INPUT", "1", "-i",
+			firewall_fail_wan_if, "-j", "DROP");
+#ifdef RTCONFIG_IPV6
+		emergency_v6 = eval("ip6tables", "-I", "INPUT", "1", "-i",
+			firewall_fail_wan_if, "-j", "DROP");
+#endif
+	}
+	if (emergency_v4
+#ifdef RTCONFIG_IPV6
+	    || emergency_v6
+#endif
+	   )
+		logmessage("firewall", "emergency WAN INPUT drop could not be installed");
+	logmessage("firewall", "ruleset validation failed; WAN INPUT is blocked and forwarding remains disabled");
+}
