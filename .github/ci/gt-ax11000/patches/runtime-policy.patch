+void do_set_regulatory_testlab_cgi(char *url, FILE *stream)
+{
+	char *country;
+	char *confirmation;
+
+	(void)url;
+	country = websGetVar(stream, "country", "");
+	confirmation = websGetVar(stream, "confirmation", "");
+	if (!rust_httpd_testlab_country_authorize(country, strlen(country),
+		confirmation, strlen(confirmation))) {
+		syslog(LOG_WARNING, "rejected invalid regulatory test-lab request");
+		websWrite(stream, "{\"statusCode\":\"-1\",\"applied\":false}");
+		return;
+	}
+
+	/* This is deliberately the only HTTP mutation boundary for regulatory
+	 * country, derived channel/DFS state, and country/board-limited power. */
+	nvram_set("location_code", country);
+	nvram_set("ui_location_code", country);
+	nvram_set("wl_country_code", country);
+	nvram_set("wl0_country_code", country);
+	nvram_set("wl1_country_code", country);
+	nvram_set("wl2_country_code", country);
+	nvram_set("0:ccode", country);
+	nvram_set("1:ccode", country);
+	nvram_set("2:ccode", country);
+	nvram_set("wl0_country_rev", "0");
+	nvram_set("wl1_country_rev", "0");
+	nvram_set("wl2_country_rev", "0");
+	nvram_set("0:regrev", "0");
+	nvram_set("1:regrev", "0");
+	nvram_set("2:regrev", "0");
+	/* Clear legacy per-radio overrides so the selected country profile is
+	 * the sole source for driver channel availability and DFS behavior. */
+	nvram_unset("wl_chlist");
+	nvram_unset("wl0_chlist");
+	nvram_unset("wl1_chlist");
+	nvram_unset("wl2_chlist");
+	nvram_unset("wl_acs_excl_chans");
+	nvram_unset("wl_acs_excl_chans_dfs");
+	nvram_unset("wl0_acs_excl_chans");
+	nvram_unset("wl1_acs_excl_chans");
+	nvram_unset("wl2_acs_excl_chans");
+	nvram_unset("wl0_acs_excl_chans_base");
+	nvram_unset("wl1_acs_excl_chans_base");
+	nvram_unset("wl2_acs_excl_chans_base");
+	/* 100 is a percentage of the selected regulatory/board-calibrated cap,
+	 * not an independent milliwatt or PA calibration override. */
+	nvram_set("wl_txpower", "100");
+	nvram_set("wl0_txpower", "100");
+	nvram_set("wl1_txpower", "100");
+	nvram_set("wl2_txpower", "100");
+	syslog(LOG_NOTICE, "authenticated regulatory country profile applied: %.3s", country);
+	notify_rc("restart_wireless");
+	websWrite(stream, "{\"statusCode\":\"0\",\"applied\":true}");
+}
