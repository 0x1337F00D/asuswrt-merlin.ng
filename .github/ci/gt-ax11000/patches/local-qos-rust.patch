diff --git a/release/src/router/httpd/local_traffic.c b/release/src/router/httpd/local_traffic.c
new file mode 100644
--- /dev/null
+++ b/release/src/router/httpd/local_traffic.c
@@ -0,0 +1,242 @@
+/* Local, privacy-preserving replacement for BWDPI realtime client counters. */
+#include <arpa/inet.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <shared.h>
+#include "httpd.h"
+
+#define LOCAL_CLIENT_LIMIT 256
+#define CONNTRACK_LINE_LIMIT 2048
+
+struct rust_conntrack_traffic {
+	char source[48];
+	char destination[48];
+	char protocol[8];
+	uint64_t original_bytes;
+	uint64_t reply_bytes;
+	uint16_t source_port;
+	uint16_t destination_port;
+};
+
+extern int rust_httpd_conntrack_traffic_parse(const char *line, size_t length,
+	struct rust_conntrack_traffic *output);
+
+struct local_client_counter {
+	char ip[INET_ADDRSTRLEN];
+	char mac[18];
+	uint64_t tx;
+	uint64_t rx;
+};
+
+struct persistent_client_counter {
+	char mac[18];
+	uint64_t raw_tx;
+	uint64_t raw_rx;
+	uint64_t total_tx;
+	uint64_t total_rx;
+};
+
+static struct persistent_client_counter persistent[LOCAL_CLIENT_LIMIT];
+static size_t persistent_count;
+
+static uint64_t saturating_add_u64(uint64_t left, uint64_t right)
+{
+	return UINT64_MAX - left < right ? UINT64_MAX : left + right;
+}
+
+static int lookup_client_by_ip(struct local_client_counter *clients,
+	size_t count, const char *ip)
+{
+	size_t i;
+
+	for (i = 0; i < count; ++i) {
+		if (!strcmp(clients[i].ip, ip))
+			return (int)i;
+	}
+	return -1;
+}
+
+static size_t read_arp_clients(struct local_client_counter *clients)
+{
+	FILE *fp;
+	char line[256];
+	char ip[INET_ADDRSTRLEN], hw_type[16], flags[16];
+	char mac[18], mask[32], device[32];
+	struct in_addr parsed_ip;
+	size_t count = 0;
+
+	fp = fopen("/proc/net/arp", "r");
+	if (!fp)
+		return 0;
+	(void)fgets(line, sizeof(line), fp);
+	while (count < LOCAL_CLIENT_LIMIT && fgets(line, sizeof(line), fp)) {
+		if (sscanf(line, "%15s %15s %15s %17s %31s %31s", ip, hw_type,
+		    flags, mac, mask, device) != 6)
+			continue;
+		if (inet_pton(AF_INET, ip, &parsed_ip) != 1 ||
+		    !isValidMacAddress(mac) || !strcmp(mac, "00:00:00:00:00:00"))
+			continue;
+		if (lookup_client_by_ip(clients, count, ip) >= 0)
+			continue;
+		strlcpy(clients[count].ip, ip, sizeof(clients[count].ip));
+		strlcpy(clients[count].mac, mac, sizeof(clients[count].mac));
+		clients[count].tx = 0;
+		clients[count].rx = 0;
+		++count;
+	}
+	fclose(fp);
+	return count;
+}
+
+static FILE *open_conntrack(void)
+{
+	FILE *fp = fopen("/proc/net/nf_conntrack", "r");
+	return fp ? fp : fopen("/proc/net/ip_conntrack", "r");
+}
+
+static void collect_conntrack_counters(struct local_client_counter *clients,
+	size_t count)
+{
+	FILE *fp;
+	char line[CONNTRACK_LINE_LIMIT + 2];
+	struct rust_conntrack_traffic record;
+	int index;
+
+	fp = open_conntrack();
+	if (!fp)
+		return;
+	while (fgets(line, sizeof(line), fp)) {
+		size_t length = strlen(line);
+
+		/* Never feed a truncated kernel record to the parser. */
+		if (length == sizeof(line) - 1 && line[length - 1] != '\n') {
+			int ch;
+			while ((ch = fgetc(fp)) != '\n' && ch != EOF)
+				;
+			continue;
+		}
+		if (!rust_httpd_conntrack_traffic_parse(line, length, &record))
+			continue;
+
+		index = lookup_client_by_ip(clients, count, record.source);
+		if (index >= 0) {
+			clients[index].tx = saturating_add_u64(clients[index].tx,
+				record.original_bytes);
+			clients[index].rx = saturating_add_u64(clients[index].rx,
+				record.reply_bytes);
+			continue;
+		}
+		index = lookup_client_by_ip(clients, count, record.destination);
+		if (index >= 0) {
+			clients[index].rx = saturating_add_u64(clients[index].rx,
+				record.original_bytes);
+			clients[index].tx = saturating_add_u64(clients[index].tx,
+				record.reply_bytes);
+		}
+	}
+	fclose(fp);
+}
+
+static struct persistent_client_counter *persistent_for_mac(const char *mac)
+{
+	size_t i;
+
+	for (i = 0; i < persistent_count; ++i) {
+		if (!strcasecmp(persistent[i].mac, mac))
+			return &persistent[i];
+	}
+	if (persistent_count == LOCAL_CLIENT_LIMIT)
+		return NULL;
+	strlcpy(persistent[persistent_count].mac, mac,
+		sizeof(persistent[persistent_count].mac));
+	return &persistent[persistent_count++];
+}
+
+static void make_monotonic(struct local_client_counter *clients, size_t count)
+{
+	size_t i;
+
+	for (i = 0; i < count; ++i) {
+		struct persistent_client_counter *state =
+			persistent_for_mac(clients[i].mac);
+		uint64_t tx_delta, rx_delta;
+
+		if (!state)
+			continue;
+		tx_delta = clients[i].tx >= state->raw_tx ?
+			clients[i].tx - state->raw_tx : 0;
+		rx_delta = clients[i].rx >= state->raw_rx ?
+			clients[i].rx - state->raw_rx : 0;
+		state->total_tx = saturating_add_u64(state->total_tx, tx_delta);
+		state->total_rx = saturating_add_u64(state->total_rx, rx_delta);
+		state->raw_tx = clients[i].tx;
+		state->raw_rx = clients[i].rx;
+		clients[i].tx = state->total_tx;
+		clients[i].rx = state->total_rx;
+	}
+}
+
+static size_t collect_local_clients(struct local_client_counter *clients)
+{
+	size_t count = read_arp_clients(clients);
+	collect_conntrack_counters(clients, count);
+	make_monotonic(clients, count);
+	return count;
+}
+
+static int write_client_traffic(webs_t wp,
+	const struct local_client_counter *clients, size_t count)
+{
+	int ret = 0;
+	char comma = ' ';
+	size_t i;
+
+	ret += websWrite(wp, "[");
+	for (i = 0; i < count; ++i) {
+		ret += websWrite(wp, "%c[\"%s\",\"%llu\",\"%llu\"]", comma,
+			clients[i].mac, (unsigned long long)clients[i].tx,
+			(unsigned long long)clients[i].rx);
+		comma = ',';
+	}
+	return ret + websWrite(wp, "]");
+}
+
+int ej_local_traffic_status(int eid, webs_t wp, int argc, char_t **argv)
+{
+	struct local_client_counter clients[LOCAL_CLIENT_LIMIT];
+	uint64_t total_tx = 0, total_rx = 0;
+	const char *client;
+	size_t count, i;
+
+	(void)eid;
+	if (argc < 4 || !argv || !argv[0])
+		return websWrite(wp, "[]");
+	client = websGetVar(wp, "client", "");
+	if (*client || (strcmp(argv[0], "traffic") && strcmp(argv[0], "traffic_wan")))
+		return websWrite(wp, "[]");
+
+	memset(clients, 0, sizeof(clients));
+	count = collect_local_clients(clients);
+	if (!strcmp(argv[0], "traffic"))
+		return write_client_traffic(wp, clients, count);
+	for (i = 0; i < count; ++i) {
+		total_tx = saturating_add_u64(total_tx, clients[i].tx);
+		total_rx = saturating_add_u64(total_rx, clients[i].rx);
+	}
+	return websWrite(wp, "[\"%llu\",\"%llu\"]",
+		(unsigned long long)total_tx, (unsigned long long)total_rx);
+}
