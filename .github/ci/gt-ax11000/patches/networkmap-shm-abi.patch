+/*
+ * The closed GT-AX11000 networkmap daemon and the current public header do
+ * not have the same size for CLIENT_DETAIL_INFO_TABLE.  The fixed trailer,
+ * however, is ABI-stable and lives at the end of the SysV segment.  Resolve
+ * it from the kernel-reported segment size so a newer reader neither sees an
+ * empty client count nor writes delete_mac into a client data array.
+ */
+typedef struct {
+	int ip_mac_num;
+	int detail_info_num;
+	int asus_device_num;
+	int commit_no;
+	char delete_mac[13];
+} NETWORKMAP_SHM_TAIL;
+
+/*
+ * The GT-AX11000 binary networkmap daemon still exports the Wi-Fi 6 layout
+ * that predates the public header's IPv6 and dhcp_flag additions.  Keep this
+ * reader private to httpd and select it only when the model and exact segment
+ * size agree.  This prevents later arrays from being interpreted through the
+ * wrong offsets while leaving every other model on the public ABI.
+ */
+typedef struct {
+	unsigned char ip_addr[MAX_NR_CLIENT_LIST][4];
+	unsigned char mac_addr[MAX_NR_CLIENT_LIST][6];
+	unsigned char user_define[MAX_NR_CLIENT_LIST][16];
+	unsigned char vendor_name[MAX_NR_CLIENT_LIST][128];
+	unsigned char device_name[MAX_NR_CLIENT_LIST][32];
+	unsigned char apple_model[MAX_NR_CLIENT_LIST][16];
+	unsigned char device_type[MAX_NR_CLIENT_LIST][32];
+	unsigned char vendorClass[MAX_NR_CLIENT_LIST][32];
+	unsigned char os_type[MAX_NR_CLIENT_LIST];
+	unsigned char sdn_idx[MAX_NR_CLIENT_LIST];
+	unsigned char online[MAX_NR_CLIENT_LIST];
+	unsigned char type[MAX_NR_CLIENT_LIST];
+	unsigned char ipMethod[MAX_NR_CLIENT_LIST][7];
+	unsigned char opMode[MAX_NR_CLIENT_LIST];
+	unsigned char device_flag[MAX_NR_CLIENT_LIST];
+	unsigned char wireless[MAX_NR_CLIENT_LIST];
+	unsigned char is_wireless[MAX_NR_CLIENT_LIST];
+	int conn_ts[MAX_NR_CLIENT_LIST];
+	int offline_time[MAX_NR_CLIENT_LIST];
+	char ssid[MAX_NR_CLIENT_LIST][32];
+	char txrate[MAX_NR_CLIENT_LIST][7];
+	char rxrate[MAX_NR_CLIENT_LIST][10];
+	unsigned int rssi[MAX_NR_CLIENT_LIST];
+	char conn_time[MAX_NR_CLIENT_LIST][12];
+	char bwdpi_host[MAX_NR_CLIENT_LIST][32];
+	char bwdpi_vendor[MAX_NR_CLIENT_LIST][100];
+	char bwdpi_type[MAX_NR_CLIENT_LIST][100];
+	char bwdpi_device[MAX_NR_CLIENT_LIST][100];
+	NETWORKMAP_SHM_TAIL tail;
+} GT_AX11000_NETWORKMAP_TABLE;
+
+typedef char gt_ax11000_networkmap_table_size_must_match[
+	(MAX_NR_CLIENT_LIST != 255 ||
+	 sizeof(GT_AX11000_NETWORKMAP_TABLE) == 174964) ? 1 : -1];
+
+#define NETWORKMAP_CLIENT_FIELD(public_layout, legacy_layout, field, index) \
+	((legacy_layout) ? (legacy_layout)->field[(index)] : \
+		(public_layout)->field[(index)])
+
+static GT_AX11000_NETWORKMAP_TABLE *networkmap_gt_ax11000_table(
+	void *shared_client_info, int shm_client_info_id)
+{
+	struct shmid_ds shm_info;
+
+	if (strcmp(nvram_safe_get("productid"), "GT-AX11000") != 0 ||
+	    shmctl(shm_client_info_id, IPC_STAT, &shm_info) != 0 ||
+	    shm_info.shm_segsz != sizeof(GT_AX11000_NETWORKMAP_TABLE))
+		return NULL;
+
+	return (GT_AX11000_NETWORKMAP_TABLE *)shared_client_info;
+}
+
+static NETWORKMAP_SHM_TAIL *networkmap_shm_tail(void *shared_client_info,
+	int shm_client_info_id)
+{
+	struct shmid_ds shm_info;
+
+	if (!shared_client_info || shared_client_info == (void *)-1)
+		return NULL;
+	if (shmctl(shm_client_info_id, IPC_STAT, &shm_info) != 0 ||
+	    shm_info.shm_segsz < sizeof(NETWORKMAP_SHM_TAIL))
+		return NULL;
+
+	return (NETWORKMAP_SHM_TAIL *)((unsigned char *)shared_client_info +
+		shm_info.shm_segsz - sizeof(NETWORKMAP_SHM_TAIL));
+}
+
+static int networkmap_shm_client_count(void *shared_client_info,
+	int shm_client_info_id, P_CLIENT_DETAIL_INFO_TABLE public_layout)
+{
+	NETWORKMAP_SHM_TAIL *tail = networkmap_shm_tail(shared_client_info,
+		shm_client_info_id);
+	int count = tail ? tail->ip_mac_num : public_layout->ip_mac_num;
+
+	return count >= 0 && count <= MAX_NR_CLIENT_LIST ? count : 0;
+}
+
+static void networkmap_shm_set_delete_mac(void *shared_client_info,
+	int shm_client_info_id, P_CLIENT_DETAIL_INFO_TABLE public_layout,
+	const char *mac)
+{
+	NETWORKMAP_SHM_TAIL *tail = networkmap_shm_tail(shared_client_info,
+		shm_client_info_id);
+	char *delete_mac = tail ? tail->delete_mac : public_layout->delete_mac;
+
+	strlcpy(delete_mac, mac, sizeof(tail->delete_mac));
+}
