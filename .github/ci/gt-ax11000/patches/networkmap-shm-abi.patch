+/*
+ * The closed GT-AX11000 networkmap daemon and the current public header do
+ * not have the same size for CLIENT_DETAIL_INFO_TABLE.  The fixed trailer,
+ * however, is ABI-stable and lives at the end of the SysV segment.  Resolve
+ * it from the kernel-reported segment size so a newer reader neither sees an
+ * empty client count nor writes delete_mac into a client data array.
+ */
+typedef struct {
+	int ip_mac_num;
+	int detail_info_num;
+	int asus_device_num;
+	int commit_no;
+	char delete_mac[13];
+} NETWORKMAP_SHM_TAIL;
+
+static NETWORKMAP_SHM_TAIL *networkmap_shm_tail(void *shared_client_info,
+	int shm_client_info_id)
+{
+	struct shmid_ds shm_info;
+
+	if (!shared_client_info || shared_client_info == (void *)-1)
+		return NULL;
+	if (shmctl(shm_client_info_id, IPC_STAT, &shm_info) != 0 ||
+	    shm_info.shm_segsz < sizeof(NETWORKMAP_SHM_TAIL))
+		return NULL;
+
+	return (NETWORKMAP_SHM_TAIL *)((unsigned char *)shared_client_info +
+		shm_info.shm_segsz - sizeof(NETWORKMAP_SHM_TAIL));
+}
+
+static int networkmap_shm_client_count(void *shared_client_info,
+	int shm_client_info_id, P_CLIENT_DETAIL_INFO_TABLE public_layout)
+{
+	NETWORKMAP_SHM_TAIL *tail = networkmap_shm_tail(shared_client_info,
+		shm_client_info_id);
+	int count = tail ? tail->ip_mac_num : public_layout->ip_mac_num;
+
+	return count >= 0 && count <= MAX_NR_CLIENT_LIST ? count : 0;
+}
+
+static void networkmap_shm_set_delete_mac(void *shared_client_info,
+	int shm_client_info_id, P_CLIENT_DETAIL_INFO_TABLE public_layout,
+	const char *mac)
+{
+	NETWORKMAP_SHM_TAIL *tail = networkmap_shm_tail(shared_client_info,
+		shm_client_info_id);
+	char *delete_mac = tail ? tail->delete_mac : public_layout->delete_mac;
+
+	strlcpy(delete_mac, mac, sizeof(tail->delete_mac));
+}
