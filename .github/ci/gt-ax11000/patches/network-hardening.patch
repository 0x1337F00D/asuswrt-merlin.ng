diff --git a/release/src/router/rc/services.c b/release/src/router/rc/services.c
--- a/release/src/router/rc/services.c
+++ b/release/src/router/rc/services.c
@@ -3858,6 +3858,18 @@ check_wps_enable()
 	int wps_enable = nvram_get_int("wps_enable_x");
 	int unit = nvram_get_int("wps_band_x");
 
+#ifdef GTAX11000
+	/* This hardened image does not expose a WPS exception.  Persist the
+	 * one-time migration so button presses and stale settings cannot restart
+	 * the registrar after a reboot. */
+	if (wps_enable || nvram_invmatch("wps_enable", "0")) {
+		nvram_set("wps_enable", "0");
+		nvram_set("wps_enable_x", "0");
+		nvram_commit();
+		wps_enable = 0;
+	}
+#endif
+
 #ifdef RTCONFIG_AMAS
 	if (nvram_get_int("re_mode") == 1)
 		return;
