diff --git a/release/src/router/httpd/web.c b/release/src/router/httpd/web.c
--- a/release/src/router/httpd/web.c
+++ b/release/src/router/httpd/web.c
@@ -4338,11 +4338,21 @@ static int validate_wlan_security_request(json_object *root)
 	if (wps_value && !strcmp(wps_value, "0") &&
 	    !get_cgi_json("wl_auth_mode_x", root) &&
 	    !get_cgi_json("wl_crypto", root) &&
-	    !get_cgi_json("wl_mfp", root))
+	    !get_cgi_json("wl_mfp", root)) {
+		nvram_set("wps_enable", "0");
+		nvram_set("wps_enable_x", "0");
 		return 1;
+	}
+	if (wps_value && strcmp(wps_value, "0"))
+		return 0;
 	unit_value = get_cgi_json("wl_unit", root);
 	unit = unit_value ? safe_atoi(unit_value) : nvram_get_int("wl_unit");
-	return validate_wlan_security_tuple(root, unit, NULL);
