diff --git a/release/src/router/Makefile b/release/src/router/Makefile
--- a/release/src/router/Makefile
+++ b/release/src/router/Makefile
@@ -2101,7 +2101,21 @@
 ifeq ($(HND_ROUTER),y)
-all: clean-build kernel_header version fsbuild $(obj-y)
+ROUTER_PACKAGE_JOBS ?= 1
+.PHONY: router-packages
+
+all:
+	+$(MAKE) clean-build
+	+$(MAKE) kernel_header version fsbuild openssl \
+		libnfnetlink-$(NETLINK_LIB_VER) libmnl-1.0.4 \
+		libnetfilter_conntrack-1.0.7 libnetfilter_cttimeout-1.0.0
+ifeq ($(ROUTER_PACKAGE_JOBS),1)
+	+$(MAKE) router-packages
+else
+	+$(MAKE) -j$(ROUTER_PACKAGE_JOBS) PARALLEL_BUILD= router-packages
+endif
+
+router-packages: $(obj-y)
 else ifeq ($(RTCONFIG_ARM),y)
 all: clean-build kernel_header libc version obj_prelibs kernel $(obj-postlibs)
 else
 all: clean-build kernel_header libc version obj_prelibs kernel $(obj-y)
 endif
@@ -8079,5 +8093,5 @@
 strongswan: openssl strongswan/Makefile
 	@$(SEP)
-	$(MAKE) -j 8 -C strongswan
+	+$(MAKE) $(PARALLEL_BUILD) -C strongswan
 ifneq (,$(filter $(ASUSWRT_BRCM_SDK_VERSION),WIFI7_SDK_20250506 WIFI8_SDK_20251126))
 	@-patchelf --force-rpath --set-rpath /usr/lib/ipsec strongswan/src/libipsec/.libs/libipsec.so
 	@-sed -i '/relink_command/d' strongswan/src/libipsec/libipsec.la
