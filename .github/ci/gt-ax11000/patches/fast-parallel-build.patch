diff --git a/release/src/router/Makefile b/release/src/router/Makefile
--- a/release/src/router/Makefile
+++ b/release/src/router/Makefile
@@ -2101,7 +2101,35 @@
 ifeq ($(HND_ROUTER),y)
-all: clean-build kernel_header version fsbuild $(obj-y)
+ROUTER_PACKAGE_JOBS ?= 1
+.PHONY: router-foundation router-packages
+
+all:
+	+$(MAKE) clean-build
+	+$(MAKE) kernel_header version fsbuild
+ifeq ($(ROUTER_PACKAGE_JOBS),1)
+	+$(MAKE) router-packages
+else
+	+$(MAKE) -j$(ROUTER_PACKAGE_JOBS) --output-sync=target \
+		PARALLEL_BUILD= router-packages
+endif
+
+# These libraries form the shared staging foundation for most HND userspace.
+# Their explicit prerequisites replace ordering that the vendor graph previously
+# obtained only from obj-y's serial list order.  A parallel invocation therefore
+# shares one GNU Make jobserver without allowing a consumer to outrun its staged
+# producer.
+libnetfilter_cttimeout-1.0.0: libmnl-1.0.4
+libdisk: shared nvram$(BCMEX)$(EX7)
+
+ROUTER_FOUNDATION_TARGETS := openssl $(OPENSSL) shared nvram$(BCMEX)$(EX7) \
+	libdisk libnfnetlink-$(NETLINK_LIB_VER) libmnl-1.0.4 \
+	libnetfilter_conntrack-1.0.7 libnetfilter_cttimeout-1.0.0
+ROUTER_PACKAGE_TARGETS := $(filter-out $(ROUTER_FOUNDATION_TARGETS),$(obj-y))
+
+router-foundation: $(ROUTER_FOUNDATION_TARGETS)
+router-packages: router-foundation .WAIT $(ROUTER_PACKAGE_TARGETS)
 else ifeq ($(RTCONFIG_ARM),y)
 all: clean-build kernel_header libc version obj_prelibs kernel $(obj-postlibs)
 else
 all: clean-build kernel_header libc version obj_prelibs kernel $(obj-y)
 endif
