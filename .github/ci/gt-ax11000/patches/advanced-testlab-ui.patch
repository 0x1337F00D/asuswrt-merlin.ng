+	testlabRequest({
+		action: "apply_radio",
+		unit: String(unit),
+		chanspec: select.value
+	}, function(ok, response) {
+		if (ok)
+			testlabCountdown(unit, Number(response.rollbackSeconds) || 600);
+	});
+}
