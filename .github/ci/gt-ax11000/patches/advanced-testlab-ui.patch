+#define TESTLAB_MODEL "GT-AX11000"
+#define TESTLAB_ROLLBACK_SECONDS 600
+#define TESTLAB_V6_CHAIN "ASUS_TESTLAB_V6"
+
+static unsigned int testlab_generation;
+
+static int
+testlab_is_model(void)
+{
+	return !strcmp(nvram_safe_get("productid"), TESTLAB_MODEL);
+}
+
+static int
+testlab_parse_unit(const char *value)
+{
+	if (!strcmp(value, "0"))
+		return 0;
+	if (!strcmp(value, "1"))
+		return 1;
+	if (!strcmp(value, "2"))
+		return 2;
+	return -1;
+}
+
+static int
+testlab_forbidden_domain(const char *value)
+{
+	return value && (!strcasecmp(value, "ALL") || !strcasecmp(value, "#a"));
+}
+
+static int
+testlab_domain_is_safe(int unit)
+{
+	char prefix[8] = {0};
+	char board_key[16] = {0};
+
+	snprintf(prefix, sizeof(prefix), "wl%d", unit);
+	snprintf(board_key, sizeof(board_key), "%d:ccode", unit == 0 ? 0 : 1);
+
+	return !testlab_forbidden_domain(nvram_pf_safe_get(prefix, "_country_code")) &&
+	       !testlab_forbidden_domain(nvram_safe_get("wl_country_code")) &&
+	       !testlab_forbidden_domain(nvram_safe_get(board_key));
+}
+
+static int
+testlab_power_is_safe(int unit)
+{
+	char key[24] = {0};
+	int global_power = nvram_get_int("wl_txpower");
+	int unit_power;
+
+	snprintf(key, sizeof(key), "wl%d_txpower", unit);
+	unit_power = nvram_get_int(key);
+
+	return (global_power <= 0 || global_power <= 100) &&
+	       (unit_power <= 0 || unit_power <= 100);
+}
+
+static int
+testlab_valid_chanspec(const char *value)
+{
+	size_t i, len;
+
+	if (!value || (len = strlen(value)) == 0 || len > 16 || !isdigit((unsigned char)value[0]))
+		return 0;
+
+	for (i = 0; i < len; ++i) {
+		if (!isdigit((unsigned char)value[i]) && value[i] != '/' &&
+		    value[i] != 'u' && value[i] != 'l' && value[i] != '-')
+			return 0;
+	}
+
+	return 1;
+}
+
+static int
+testlab_radio_ifname(int unit, char *ifname, size_t ifname_size)
+{
+	char prefix[8] = {0};
+	const char *value;
+	size_t i;
+
+	if (unit < 0 || unit > 2)
+		return 0;
+
+	snprintf(prefix, sizeof(prefix), "wl%d", unit);
+	value = nvram_pf_safe_get(prefix, "_ifname");
+	if (!value || !*value || strlen(value) >= ifname_size)
+		return 0;
+
+	for (i = 0; value[i]; ++i) {
+		if (!isalnum((unsigned char)value[i]) && value[i] != '_' &&
+		    value[i] != '-' && value[i] != '.' && value[i] != ':')
+			return 0;
+	}
+
+	strlcpy(ifname, value, ifname_size);
+	return 1;
+}
+
+static int
+testlab_set_runtime_chanspec(int unit, const char *chanspec)
+{
+	char ifname[16] = {0};
+	int ret;
+
+	if (!testlab_radio_ifname(unit, ifname, sizeof(ifname)) ||
+	    !testlab_valid_chanspec(chanspec))
+		return 0;
+
+	eval("wl", "-i", ifname, "down");
+	ret = eval("wl", "-i", ifname, "chanspec", chanspec);
+	eval("wl", "-i", ifname, "up");
+
+	return ret == 0;
+}
+
+static int
+testlab_restore_radio(int unit)
+{
+	char prefix[8] = {0};
+	const char *configured;
+
+	snprintf(prefix, sizeof(prefix), "wl%d", unit);
+	configured = nvram_pf_safe_get(prefix, "_chanspec");
+	if (!testlab_valid_chanspec(configured))
+		configured = "0";
+
+	return testlab_set_runtime_chanspec(unit, configured);
+}
+
+static void
+testlab_rollback_path(int unit, char *path, size_t path_size)
+{
+	snprintf(path, path_size, "/tmp/advanced_testlab_wl%d.rollback", unit);
+}
+
+static int
+testlab_schedule_radio_rollback(int unit)
+{
+	char path[64] = {0};
+	unsigned long generation;
+	FILE *fp;
+	pid_t pid;
+
+	generation = ((unsigned long)time(NULL) << 16) ^
+	             ((unsigned long)getpid() << 4) ^ ++testlab_generation;
+	testlab_rollback_path(unit, path, sizeof(path));
+
+	if (!(fp = fopen(path, "w")))
+		return 0;
+	fprintf(fp, "%lu\n", generation);
+	fclose(fp);
+
+	pid = fork();
+	if (pid < 0) {
+		unlink(path);
+		return 0;
+	}
+	if (pid == 0) {
+		unsigned int remaining = TESTLAB_ROLLBACK_SECONDS;
+		unsigned long current = 0;
+		long max_fd = sysconf(_SC_OPEN_MAX);
+		int fd;
+
+		setsid();
+		if (max_fd < 0 || max_fd > 1024)
+			max_fd = 1024;
+		for (fd = 0; fd < max_fd; ++fd)
+			close(fd);
+		while (remaining)
+			remaining = sleep(remaining);
+
+		if ((fp = fopen(path, "r")) != NULL) {
+			if (fscanf(fp, "%lu", &current) != 1)
+				current = 0;
+			fclose(fp);
+		}
+		if (current == generation) {
+			testlab_restore_radio(unit);
+			unlink(path);
+		}
+		_exit(0);
+	}
+
+	return 1;
+}
+
+static void
+testlab_cancel_radio_rollback(int unit)
+{
+	char path[64] = {0};
+
+	testlab_rollback_path(unit, path, sizeof(path));
+	unlink(path);
+}
+
+static int
+testlab_restore_power(int unit)
+{
+	char ifname[16] = {0};
+
+	if (!testlab_radio_ifname(unit, ifname, sizeof(ifname)))
+		return 0;
+	return eval("wl", "-i", ifname, "txpwr1", "-1") == 0;
+}
+
+static int
+testlab_ipv6_block_enabled(void)
+{
+	return eval("ip6tables", "-C", "FORWARD", "-j", TESTLAB_V6_CHAIN) == 0;
+}
+
+static int
+testlab_set_ipv6_block(int enable)
+{
+	int ret = 1;
+
+	if (enable) {
+		eval("ip6tables", "-N", TESTLAB_V6_CHAIN);
+		eval("ip6tables", "-F", TESTLAB_V6_CHAIN);
+		if (eval("ip6tables", "-A", TESTLAB_V6_CHAIN, "-j", "REJECT") != 0)
+			ret = 0;
+		if (ret && !testlab_ipv6_block_enabled() &&
+		    eval("ip6tables", "-I", "FORWARD", "1", "-j", TESTLAB_V6_CHAIN) != 0)
+			ret = 0;
+	} else {
+		while (testlab_ipv6_block_enabled())
+			eval("ip6tables", "-D", "FORWARD", "-j", TESTLAB_V6_CHAIN);
+		eval("ip6tables", "-F", TESTLAB_V6_CHAIN);
+		eval("ip6tables", "-X", TESTLAB_V6_CHAIN);
+	}
+
+	return ret;
+}
+
+static void
+do_advanced_testlab_cgi(char *url, FILE *stream)
+{
+	struct json_object *root = json_object_new_object();
+	const char *action;
+	const char *confirm;
+	const char *chanspec;
+	int unit = -1;
+	int status = HTTP_INVALID_INPUT;
+	const char *message = "invalid request";
+
+	do_json_decode(root);
+	action = safe_get_cgi_json("action", root);
+	confirm = safe_get_cgi_json("confirm", root);
+
+	if (!testlab_is_model()) {
+		message = "unsupported model";
+		goto finish;
+	}
+	if (strcmp(confirm, "TEMPORARY")) {
+		message = "confirmation required";
+		goto finish;
+	}
+
+	if (!strcmp(action, "apply_radio")) {
+		unit = testlab_parse_unit(safe_get_cgi_json("unit", root));
+		chanspec = safe_get_cgi_json("chanspec", root);
+		if (unit < 0 || !testlab_valid_chanspec(chanspec)) {
+			message = "invalid radio or chanspec";
+		} else if (!testlab_domain_is_safe(unit) || !testlab_power_is_safe(unit)) {
+			message = "unsafe regulatory or power override detected";
+		} else if (!testlab_set_runtime_chanspec(unit, chanspec)) {
+			message = "driver rejected chanspec";
+		} else if (!testlab_schedule_radio_rollback(unit)) {
+			testlab_restore_radio(unit);
+			message = "rollback could not be scheduled";
+		} else {
+			status = HTTP_OK;
+			message = "temporary chanspec applied";
+		}
+	} else if (!strcmp(action, "restore_radio")) {
+		unit = testlab_parse_unit(safe_get_cgi_json("unit", root));
+		if (unit >= 0) {
+			testlab_cancel_radio_rollback(unit);
+			if (testlab_restore_radio(unit)) {
+				status = HTTP_OK;
+				message = "configured chanspec restored";
+			} else {
+				message = "driver rejected configured chanspec";
+			}
+		}
+	} else if (!strcmp(action, "restore_power")) {
+		unit = testlab_parse_unit(safe_get_cgi_json("unit", root));
+		if (unit >= 0 && testlab_restore_power(unit)) {
+			status = HTTP_OK;
+			message = "automatic regulatory power restored";
+		} else {
+			message = "power restore failed";
+		}
+	} else if (!strcmp(action, "ipv6_block")) {
+		const char *enabled = safe_get_cgi_json("enabled", root);
+		if ((!strcmp(enabled, "0") || !strcmp(enabled, "1")) &&
+		    testlab_set_ipv6_block(!strcmp(enabled, "1"))) {
+			status = HTTP_OK;
+			message = !strcmp(enabled, "1") ? "temporary IPv6 forwarding block enabled" :
+			                                 "temporary IPv6 forwarding block disabled";
+		}
+	} else if (!strcmp(action, "status")) {
+		status = HTTP_OK;
+		message = "ok";
+	}
+
+finish:
+	websWrite(stream,
+	          "{\"statusCode\":%d,\"message\":\"%s\",\"ipv6Blocked\":%s,\"rollbackSeconds\":%d}",
+	          status, message, testlab_ipv6_block_enabled() ? "true" : "false",
+	          TESTLAB_ROLLBACK_SECONDS);
+	if (root)
+		json_object_put(root);
+}
