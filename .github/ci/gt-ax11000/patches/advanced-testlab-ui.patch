+function testlabCountdown(unit, seconds) {
+	if (testlabTimers[unit])
+		window.clearInterval(testlabTimers[unit]);
+
+	var target = document.getElementById("rollback_" + unit);
+	var remaining = seconds;
+	function render() {
+		var minutes = Math.floor(remaining / 60);
+		var secs = remaining % 60;
+		target.innerHTML = remaining > 0
+			? "Automatisches Rollback in " + minutes + ":" + (secs < 10 ? "0" : "") + secs
+			: "Rollback wird ausgef&uuml;hrt";
+		if (remaining-- <= 0)
+			window.clearInterval(testlabTimers[unit]);
+	}
+	render();
+	testlabTimers[unit] = window.setInterval(render, 1000);
+}
+
+function testlabApply(unit) {
