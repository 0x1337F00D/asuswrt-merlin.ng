+function testlabRequest(payload, done) {
+	payload.confirm = "TEMPORARY";
+	$.ajax({
+		url: "/advanced_testlab.cgi",
+		type: "POST",
+		contentType: "application/json",
+		dataType: "json",
+		data: JSON.stringify(payload),
+		success: function(response) {
+			var ok = Number(response.statusCode) === 200;
+			testlabMessage(response.message || (ok ? "OK" : "Fehler"), ok);
+			document.getElementById("ipv6_block").checked = !!response.ipv6Blocked;
+			if (done)
+				done(ok, response);
+		},
+		error: function() {
+			testlabMessage("Die tempor&auml;re Einstellung konnte nicht angewendet werden.", false);
+			if (done)
+				done(false, {});
+		}
+	});
