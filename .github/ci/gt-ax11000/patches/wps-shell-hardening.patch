+static int wps_cli_run(const char *mode, const char *prefix, const char *ifname,
+	const char *command, const char *pin)
+{
+	char control[64];
+	char *argv[12];
+	int argc = 0;
+	int status = 0;
+	pid_t pid;
+
+	if (!mode || !prefix || !ifname || !command || !*ifname ||
+		strlen(ifname) >= IFNAMSIZ ||
+		strspn(ifname, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.:-") != strlen(ifname) ||
+		strlen(prefix) >= 16 ||
+		strspn(prefix, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.:-") != strlen(prefix))
+		return 0;
+	if (strcmp(command, "wps_cancel") && strcmp(command, "wps_pbc") && strcmp(command, "wps_pin"))
+		return 0;
+	if ((!strcmp(command, "wps_pin") && (!pin || strlen(pin) != 8 ||
+		strspn(pin, "0123456789") != 8)) || (strcmp(command, "wps_pin") && pin))
+		return 0;
+
+	if (!strcmp(mode, "ap"))
+		return hapd_cli_run(ifname, command, NULL, NULL, NULL);
+
+	argv[argc++] = "/usr/sbin/wpa_cli-2.7";
+#if !defined(NEW_WPA_CLI)
+	if ((size_t)snprintf(control, sizeof(control), "/var/run/%s_wpa_supplicant", prefix) >= sizeof(control))
+		return 0;
+	argv[argc++] = "-p";
+	argv[argc++] = control;
+#else
+	(void)control;
+#endif
+	argv[argc++] = "-i";
+	argv[argc++] = (char *)ifname;
+	argv[argc++] = (char *)command;
+	if (pin) {
+		argv[argc++] = "any";
+		argv[argc++] = (char *)pin;
+	}
+	argv[argc] = NULL;
+
+	pid = fork();
+	if (pid == 0) {
+		execv(argv[0], argv);
+		_exit(127);
+	}
+	if (pid < 0 || waitpid(pid, &status, 0) < 0)
+		return 0;
+	return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
