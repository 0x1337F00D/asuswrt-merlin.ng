+/* "MAC>CAP<MAC>RE<..." for the Rust database view.  get_amas_info() stays
+ * json-c based; its objects are released here and never reach Rust. */
+static void clientlist_amas_node_types(char *buffer, size_t capacity)
+{
+	struct json_object *amasList = json_object_new_object(), *type = NULL;
+	size_t used = 0;
+	int written;
+
+	buffer[0] = '\0';
+	if(amasList && get_amas_info(amasList)){
+		json_object_object_foreach(amasList, key, val) {
+			if(!json_object_object_get_ex(val, "type", &type))
+				continue;
+			written = snprintf(buffer + used, capacity - used, "%s%s>%s",
+				used ? "<" : "", key, json_object_get_string(type));
+			if(written < 0 || (size_t)written >= capacity - used){
+				buffer[used] = '\0';
+				break;
 			}
+			used += (size_t)written;
 		}
 	}
+	if(amasList)
+		json_object_put(amasList);
+}
