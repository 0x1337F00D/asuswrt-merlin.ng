+	const char *new_chain[] = { "-t", "filter", "-N", CODEX_WAN_GUARD, NULL };
+	const char *return_rule[] = { "-t", "filter", "-A", CODEX_WAN_GUARD,
+		"-j", "RETURN", NULL };
+	const char *insert_hook[] = { "-t", "filter", "-I", "INPUT", "1",
+		"-i", wan_if, "-j", CODEX_WAN_GUARD, NULL };
 
 	if (!wan_if || !wan_if[0])
 		return 0;
-	/* Cleanup failures are harmless; creation and every active rule are checked. */
-	eval(tool, "-t", "filter", "-D", "INPUT", "-i", wan_if,
-		"-j", CODEX_WAN_GUARD);
-	eval(tool, "-t", "filter", "-F", CODEX_WAN_GUARD);
-	eval(tool, "-t", "filter", "-X", CODEX_WAN_GUARD);
-	if (eval(tool, "-t", "filter", "-N", CODEX_WAN_GUARD) != 0)
+	/* Delete every possible stale hook left by an interrupted prior apply.
+	 * Expected cleanup misses are quiet and are never treated as success. */
+	for (i = 0; i < 8; ++i) {
