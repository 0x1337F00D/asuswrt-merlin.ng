@@ -90,6 +90,41 @@ extern int rust_validate_effective_firewall_policy_files(const char *ipv4_path,
 	const char *wan_ipv6_interface, const char *admin_ports);
 
 #define CODEX_WAN_GUARD "CODEX_WAN_GUARD"
+#define WAN_GUARD_COMMAND_ATTEMPTS 10
+#define WAN_GUARD_COMMAND_DELAY_US 100000
+
+/* The vendor firewall and user firewall-start hook can finish adjacent
+ * iptables updates after start_firewall() releases its file lock.  iptables
+ * 1.4.15 on this model has no --wait option, so retry only our fixed argv
+ * operations for a short bounded interval. */
+static int run_wan_guard_command(const char *tool, const char *stage,
+	unsigned int attempts, const char *const arguments[])
+{
+	char *argv[16];
+	unsigned int argc = 0, attempt;
+	int result = -1;
+
+	if (!tool || !tool[0] || !arguments || attempts == 0)
+		return 0;
+	argv[argc++] = (char *)tool;
+	while (*arguments && argc < sizeof(argv) / sizeof(argv[0]) - 1)
+		argv[argc++] = (char *)*arguments++;
+	if (*arguments)
+		return 0;
+	argv[argc] = NULL;
+
+	for (attempt = 0; attempt < attempts; ++attempt) {
+		result = _eval(argv, NULL, 0, NULL);
+		if (result == 0)
+			return 1;
+		if (attempt + 1 < attempts)
+			usleep(WAN_GUARD_COMMAND_DELAY_US);
+	}
+	if (stage)
+		logmessage("firewall", "WAN guard %s/%s failed after %u attempts (status %d)",
+			tool, stage, attempts, result);
+	return 0;
+}
 
