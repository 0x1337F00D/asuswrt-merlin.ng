+	if (!run_wan_guard_command(tool, "new-chain", WAN_GUARD_COMMAND_ATTEMPTS,
+	    new_chain))
 		return 0;
 	for (i = 0; i < count; ++i) {
-		if (eval(tool, "-t", "filter", "-A", CODEX_WAN_GUARD,
-		    "-p", "tcp", "-m", "tcp", "--dport", ports[i],
-		    "-j", "DROP") != 0)
+		const char *drop_rule[] = { "-t", "filter", "-A", CODEX_WAN_GUARD,
