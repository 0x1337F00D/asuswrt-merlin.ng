diff --git a/release/src/router/rc/firewall.c b/release/src/router/rc/firewall.c
index 9db1af22d0a..d54e37bb5f8 100644
--- a/release/src/router/rc/firewall.c
+++ b/release/src/router/rc/firewall.c
@@ -81,9 +81,105 @@
 
 static int firewall_apply_failed;
 static char firewall_fail_wan_if[IFNAMSIZ + 1];
+static char firewall_admin_ports[64];
 
 extern int rust_validate_effective_firewall_files(const char *ipv4_path,
 	const char *ipv6_path, int require_ipv6);
+extern int rust_validate_effective_firewall_policy_files(const char *ipv4_path,
+	const char *ipv6_path, int require_ipv6, const char *wan_ipv4_interface,
+	const char *wan_ipv6_interface, const char *admin_ports);
+
+#define CODEX_WAN_GUARD "CODEX_WAN_GUARD"
+
+static int add_unique_admin_port(char ports[][6], unsigned int *count, int port)
+{
+	unsigned int i;
+
+	if (port < 1 || port > 65535 || *count >= 8)
+		return 0;
+	for (i = 0; i < *count; ++i) {
+		if (atoi(ports[i]) == port)
+			return 1;
+	}
+	snprintf(ports[*count], sizeof(ports[*count]), "%d", port);
+	++*count;
+	return 1;
+}
+
+static int install_wan_admin_guard_family(const char *tool, const char *wan_if,
+	char ports[][6], unsigned int count)
+{
+	unsigned int i;
+
+	if (!wan_if || !wan_if[0])
+		return 0;
+	/* Cleanup failures are harmless; creation and every active rule are checked. */
+	eval(tool, "-t", "filter", "-D", "INPUT", "-i", wan_if,
+		"-j", CODEX_WAN_GUARD);
+	eval(tool, "-t", "filter", "-F", CODEX_WAN_GUARD);
+	eval(tool, "-t", "filter", "-X", CODEX_WAN_GUARD);
+	if (eval(tool, "-t", "filter", "-N", CODEX_WAN_GUARD) != 0)
+		return 0;
+	for (i = 0; i < count; ++i) {
+		if (eval(tool, "-t", "filter", "-A", CODEX_WAN_GUARD,
+		    "-p", "tcp", "-m", "tcp", "--dport", ports[i],
+		    "-j", "DROP") != 0)
+			return 0;
+	}
+	if (eval(tool, "-t", "filter", "-A", CODEX_WAN_GUARD,
+	    "-j", "RETURN") != 0)
+		return 0;
+	return eval(tool, "-t", "filter", "-I", "INPUT", "1",
+		"-i", wan_if, "-j", CODEX_WAN_GUARD) == 0;
+}
+
+static int install_wan_admin_guard(const char *wan_if)
+{
+	char ports[8][6];
+	unsigned int count = 0, i;
+	size_t used = 0;
+
+	memset(ports, 0, sizeof(ports));
+	/* Telnet is deliberately never reachable through WAN on this hardened build. */
+	if (!add_unique_admin_port(ports, &count, 23))
+		return 0;
+	if (!nvram_get_int("misc_http_x")) {
+		if (!add_unique_admin_port(ports, &count, 80) ||
+		    !add_unique_admin_port(ports, &count, 443) ||
+		    !add_unique_admin_port(ports, &count,
+			nvram_get_int("http_lanport") ? : 80) ||
+		    !add_unique_admin_port(ports, &count,
+			nvram_get_int("https_lanport") ? : 443) ||
+		    !add_unique_admin_port(ports, &count,
+			nvram_get_int("misc_httpport_x") ? : 8080) ||
+		    !add_unique_admin_port(ports, &count,
+			nvram_get_int("misc_httpsport_x") ? : 8443))
+			return 0;
+	}
+	if (nvram_get_int("sshd_enable") != 1 &&
+	    !add_unique_admin_port(ports, &count,
+		nvram_get_int("sshd_port") ? : 22))
+		return 0;
+
+	firewall_admin_ports[0] = '\0';
+	for (i = 0; i < count; ++i) {
+		int written = snprintf(firewall_admin_ports + used,
+			sizeof(firewall_admin_ports) - used, "%s%s",
+			i ? "," : "", ports[i]);
+		if (written < 0 || (size_t)written >= sizeof(firewall_admin_ports) - used)
+			return 0;
+		used += written;
+	}
+
+	if (!install_wan_admin_guard_family("iptables", wan_if, ports, count))
+		return 0;
+#ifdef RTCONFIG_IPV6
+	if (ipv6_enabled() &&
+	    !install_wan_admin_guard_family("ip6tables", get_wan6face(), ports, count))
+		return 0;
+#endif
+	return 1;
+}
 
