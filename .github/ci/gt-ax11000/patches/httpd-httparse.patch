+/*
+ * Read the request line and every header line, up to and including the
+ * terminating empty line, and nothing more: the body has to stay in the
+ * stream for handler->input().  Reading byte by byte is what lets an
+ * embedded NUL reach the parser instead of being hidden by fgets().
+ *
+ * Returns the number of bytes placed in buffer, 0 when the peer closed
+ * before sending anything (the vendor answered nothing in that case), or
+ * -1 when the block did not fit.
+ */
+static ssize_t
+read_request_block(FILE *stream, char *buffer, size_t capacity)
+{
+	size_t used = 0, line_start = 0, end;
+	int c;
+
+	while (used < capacity) {
+		c = getc(stream);
+		if (c == EOF) {
+			if (used == 0)
+				return 0;
+			/*
+			 * The vendor's header fgets() returned NULL here and
+			 * served the request anyway, so terminate the block
+			 * and let the parser see the same request.
+			 */
+			if (capacity - used < 4)
+				return -1;
+			buffer[used++] = '\r';
+			buffer[used++] = '\n';
+			buffer[used++] = '\r';
+			buffer[used++] = '\n';
+			return (ssize_t) used;
+		}
+		buffer[used++] = (char) c;
+		if (c != '\n')
+			continue;
+		end = used - 1;
+		if (end > line_start && buffer[end - 1] == '\r')
+			end--;
+		if (end == line_start)
+			return (ssize_t) used;
+		line_start = used;
+	}
+
+	return -1;
+}
