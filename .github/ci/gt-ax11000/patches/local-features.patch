+#ifdef RTCONFIG_BWDPI
+	if (access("/proc/bw_cte_dump", R_OK) == 0 && access(APPDB, R_OK) == 0)
+		return ej_tm_bwdpi_conntrack(eid, wp, argc, argv_);
+#endif
+	return ej_local_conntrack(eid, wp, argc, argv_);
+}
