+static int extract_conntrack_value(const char *line, const char *key, char *value, size_t value_len)
+{
+	const char *p = line;
+	size_t key_len = strlen(key);
+	size_t len;
+
+	while ((p = strstr(p, key)) != NULL) {
+		if ((p == line || isspace((unsigned char)p[-1])) && p[key_len] == '=') {
+			p += key_len + 1;
+			len = strcspn(p, " \t\r\n");
+			if (len >= value_len)
+				len = value_len - 1;
+			memcpy(value, p, len);
+			value[len] = '\0';
+			return 1;
+		}
+		p += key_len;
+	}
+
+	return 0;
+}
+
+static int conntrack_port_matches(int sport, int dport, int port)
+{
+	return sport == port || dport == port;
+}
+
+static int conntrack_port_in_range(int sport, int dport, int low, int high)
+{
+	return (sport >= low && sport <= high) || (dport >= low && dport <= high);
+}
+
+static void classify_local_conntrack(const char *proto, int sport, int dport, int *category, int *appid, char *desc, size_t desc_len)
+{
+	*appid = 0;
+
+	if (!strcmp(proto, "icmp") || !strcmp(proto, "icmpv6") || !strcmp(proto, "gre")) {
+		*category = 9;
+		strlcpy(desc, "Local network control", desc_len);
+	} else if (conntrack_port_matches(sport, dport, 53)) {
+		*category = 9;
+		strlcpy(desc, "Local DNS", desc_len);
+	} else if (conntrack_port_matches(sport, dport, 67) || conntrack_port_matches(sport, dport, 68)) {
+		*category = 9;
+		strlcpy(desc, "Local DHCP", desc_len);
+	} else if (conntrack_port_matches(sport, dport, 123)) {
+		*category = 9;
+		strlcpy(desc, "Local NTP", desc_len);
+	} else if (conntrack_port_matches(sport, dport, 80) || conntrack_port_matches(sport, dport, 443) ||
+		   conntrack_port_matches(sport, dport, 8080) || conntrack_port_matches(sport, dport, 8443) ||
+		   conntrack_port_matches(sport, dport, 853)) {
+		*category = 13;
+		strlcpy(desc, "Local web", desc_len);
+	} else if (conntrack_port_matches(sport, dport, 554) || conntrack_port_matches(sport, dport, 1935) ||
+		   conntrack_port_matches(sport, dport, 5004) || conntrack_port_matches(sport, dport, 5005)) {
+		*category = 4;
+		strlcpy(desc, "Local streaming", desc_len);
+	} else if (conntrack_port_matches(sport, dport, 3478) || conntrack_port_matches(sport, dport, 5060) ||
+		   conntrack_port_matches(sport, dport, 5061) || conntrack_port_matches(sport, dport, 5222) ||
+		   conntrack_port_matches(sport, dport, 5223)) {
+		*category = 5;
+		strlcpy(desc, "Local messaging/voice", desc_len);
+	} else if (conntrack_port_matches(sport, dport, 20) || conntrack_port_matches(sport, dport, 21) ||
+		   conntrack_port_matches(sport, dport, 22) || conntrack_port_matches(sport, dport, 445) ||
+		   conntrack_port_matches(sport, dport, 873) || conntrack_port_in_range(sport, dport, 6881, 6999)) {
+		*category = 1;
+		strlcpy(desc, "Local file transfer", desc_len);
+	} else {
+		*category = 7;
+		strlcpy(desc, "Local other", desc_len);
+	}
+}
+
+static int ej_local_conntrack(int eid, webs_t wp, int argc, char **argv_)
+{
+	FILE *fp = NULL;
+	char line[512];
+	char proto[16], src_ip[64], dst_ip[64], sport_s[16], dport_s[16];
+	char desc[64];
+	int sport, dport, category, appid;
+	int ret;
+	char comma = ' ';
+
+	(void)eid;
+	(void)argc;
+	(void)argv_;
+
+	fp = fopen("/proc/net/nf_conntrack", "r");
+	if (fp == NULL)
+		fp = fopen("/proc/net/ip_conntrack", "r");
+	if (fp == NULL)
+		return websWrite(wp, "bwdpi_conntrack=[];");
+
+	ret = websWrite(wp, "bwdpi_conntrack=[");
+
+	while (fgets(line, sizeof(line), fp)) {
+		if (sscanf(line, "%*s %*d %15s", proto) != 1)
+			continue;
+		if (!extract_conntrack_value(line, "src", src_ip, sizeof(src_ip)) ||
+		    !extract_conntrack_value(line, "dst", dst_ip, sizeof(dst_ip)))
+			continue;
+
+		if (!extract_conntrack_value(line, "sport", sport_s, sizeof(sport_s)))
+			sport = 0;
+		else
+			sport = atoi(sport_s);
+
+		if (!extract_conntrack_value(line, "dport", dport_s, sizeof(dport_s)))
+			dport = 0;
+		else
+			dport = atoi(dport_s);
+
+		classify_local_conntrack(proto, sport, dport, &category, &appid, desc, sizeof(desc));
+
+		ret += websWrite(wp, "%c[\"%s\", \"%s\", \"%d\", \"%s\", \"%d\", \"%s\", \"%d\", \"%d\"]",
+				  comma, proto, src_ip, sport, dst_ip, dport, desc, category, appid);
+		comma = ',';
+	}
+	fclose(fp);
+
+	ret += websWrite(wp, "];\n");
+	return ret;
+}
