diff --git a/release/src/router/httpd/Makefile b/release/src/router/httpd/Makefile
--- a/release/src/router/httpd/Makefile
+++ b/release/src/router/httpd/Makefile
@@ -1,5 +1,11 @@
 include ../common.mak
 
+ifeq ($(BUILD_NAME),GT-AX11000)
+ifneq ($(wildcard $(TOP)/rust-components/mssl-server/Cargo.toml),)
+CFLAGS += -DRUST_MSSL_PRESERVE_CREDENTIALS
+endif
+endif
+
 CFLAGS += -Os -Wall $(EXTRACFLAGS)
 CFLAGS += $(PRIVATE_EXTRACFLAGS)
 CFLAGS += -I$(SRCBASE) -I.
diff --git a/release/src/router/httpd/httpd.c b/release/src/router/httpd/httpd.c
--- a/release/src/router/httpd/httpd.c
+++ b/release/src/router/httpd/httpd.c
@@ -2960,6 +2960,18 @@
 		save = nvram_match("https_crt_save", "1");
 
+#ifdef RUST_MSSL_PRESERVE_CREDENTIALS
+		/* A provider change must not silently destroy existing user keys.
+		 * Explicit https_crt_gen above and empty factory state still generate. */
+		if ((f_exists(HTTPD_CERT) || f_exists(HTTPD_KEY)) &&
+		    !mssl_cert_key_match(HTTPD_CERT, HTTPD_KEY)) {
+			logmessage("httpd", "TLS credentials unsupported or invalid; preserved, HTTPS stopped: %d", http_port);
+			file_unlock(lock);
+			exit(1);
+		}
+#endif
+
 		/* check selected key/cert pairs */
 		if (!f_exists(HTTPD_CERT) || !f_exists(HTTPD_KEY)
 		 || !mssl_cert_key_match(HTTPD_CERT, HTTPD_KEY)
@@ -3005,6 +3017,13 @@
 			return;
 		}
 
+#ifdef RUST_MSSL_PRESERVE_CREDENTIALS
+		/* Initialization errors are not authorization to replace keys. */
+		logmessage("httpd", "TLS initialization failed; credentials preserved: %d", http_port);
+		file_unlock(lock);
+		exit(1);
+#endif
+
 		logmessage("httpd", "Failed to initialize SSL, generating new key/cert...%d", http_port);
 		erase_cert();
 
