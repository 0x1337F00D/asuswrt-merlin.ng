diff --git a/release/src/router/rc/lan.c b/release/src/router/rc/lan.c
--- a/release/src/router/rc/lan.c
+++ b/release/src/router/rc/lan.c
@@ -6612,6 +6612,89 @@ void start_fbwifi_config()
 }
 #endif
 
+#if defined(GTAX11000)
+extern int rust_regulatory_profile_kind(const char *country);
+
+static void regulatory_profile_set(const char *name, const char *value, int *changed)
+{
+	const char *current = nvram_get(name);
+
+	if (!current || strcmp(current, value)) {
+		nvram_set(name, value);
+		*changed = 1;
+	}
+}
+
+static void regulatory_profile_unset(const char *name, int *changed)
+{
+	if (nvram_get(name)) {
+		nvram_unset(name);
+		*changed = 1;
+	}
+}
+
+int apply_regulatory_testlab_profile(void)
+{
+	static const char *country_keys[] = {
+		"wl_country_code", "wl0_country_code", "wl1_country_code", "wl2_country_code",
+		"0:ccode", "1:ccode", "2:ccode"
+	};
+	static const char *revision_keys[] = {
+		"wl0_country_rev", "wl1_country_rev", "wl2_country_rev",
+		"0:regrev", "1:regrev", "2:regrev"
+	};
+	static const char *legacy_override_keys[] = {
+		"wl_chlist", "wl0_chlist", "wl1_chlist", "wl2_chlist",
+		"wl_acs_excl_chans", "wl_acs_excl_chans_dfs",
+		"wl0_acs_excl_chans", "wl1_acs_excl_chans", "wl2_acs_excl_chans",
+		"wl0_acs_excl_chans_base", "wl1_acs_excl_chans_base",
+		"wl2_acs_excl_chans_base"
+	};
+	char country[4];
+	const char *driver_country;
+	const char *txpower;
+	int changed = 0;
+	int kind;
+	unsigned int index;
+
+	if (!nvram_match("rust_regulatory_testlab_ack_v1", "1"))
+		return 0;
+	strlcpy(country, nvram_safe_get("location_code"), sizeof(country));
+	kind = rust_regulatory_profile_kind(country);
+	if (kind != 1 && kind != 2) {
+		logmessage("wireless", "rejected invalid persisted regulatory country profile");
+		return -1;
+	}
+	driver_country = kind == 2 ? "#a" : country;
+	txpower = kind == 2 ? "500" : "100";
+
+	regulatory_profile_set("ui_location_code", country, &changed);
+	for (index = 0; index < sizeof(country_keys) / sizeof(country_keys[0]); ++index)
+		regulatory_profile_set(country_keys[index], driver_country, &changed);
+	for (index = 0; index < sizeof(revision_keys) / sizeof(revision_keys[0]); ++index)
+		regulatory_profile_set(revision_keys[index], "0", &changed);
+	for (index = 0; index < sizeof(legacy_override_keys) / sizeof(legacy_override_keys[0]); ++index)
+		regulatory_profile_unset(legacy_override_keys[index], &changed);
+
+	regulatory_profile_set("acs_unii4", kind == 2 ? "1" : "0", &changed);
+	regulatory_profile_set("acs_band1", kind == 2 ? "1" : "0", &changed);
+	regulatory_profile_set("acs_band3", kind == 2 ? "1" : "0", &changed);
+	regulatory_profile_set("acs_dfs", "1", &changed);
+	regulatory_profile_set("wl1_acs_dfs", "1", &changed);
+	regulatory_profile_set("wl2_acs_dfs", "1", &changed);
+	regulatory_profile_set("wl_txpower", txpower, &changed);
+	regulatory_profile_set("wl0_txpower", txpower, &changed);
+	regulatory_profile_set("wl1_txpower", txpower, &changed);
+	regulatory_profile_set("wl2_txpower", txpower, &changed);
+
+	if (changed) {
+		nvram_commit();
+		logmessage("wireless", "applied persisted regulatory country profile %.3s", country);
+	}
+	return changed;
+}
+#endif
