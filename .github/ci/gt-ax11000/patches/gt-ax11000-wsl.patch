+int webswrite(webs_t wp, const char *fmt, ...)
+{
+	int ret;
+	va_list ap;
+
+	va_start(ap, fmt);
+	ret = vfprintf(wp, fmt, ap);
+	va_end(ap);
+	fflush(wp);
+
+	return ret;
+}
+
+uint8 *bcm_find_tlv(uint8 *tlvs, uint buflen, uint key)
+{
+	while (buflen >= 2) {
+		uint len = tlvs[1];
+
+		if (buflen < len + 2)
+			break;
+
+		if (tlvs[0] == key)
+			return tlvs;
+
+		tlvs += len + 2;
+		buflen -= len + 2;
+	}
+
+	return NULL;
+}
